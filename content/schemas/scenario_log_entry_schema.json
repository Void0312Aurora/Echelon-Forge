{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioLogEntry",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {"const": "meta"},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "tick", "sim_time", "entities", "detections"],
      "properties": {
        "type": {"const": "tick"},
        "tick": {"type": "integer"},
        "sim_time": {"type": "number"},
        "entities": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          }
        },
        "detections": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target_id", "range", "bearing", "timestamp"],
              "properties": {
                "target_id": {"type": "integer"},
                "range": {"type": "number"},
                "bearing": {"type": "number"},
                "timestamp": {"type": "number"}
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
