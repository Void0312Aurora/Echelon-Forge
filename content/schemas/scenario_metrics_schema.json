{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioMetrics",
  "type": "object",
  "required": ["schema_version", "min_range", "first_detection_time", "detection_count", "destroyed", "require_detection", "detected", "steps"],
  "properties": {
    "schema_version": {"type": "integer"},
    "min_range": {"type": ["number", "null"]},
    "first_detection_time": {"type": ["number", "null"]},
    "detection_count": {"type": "integer"},
    "destroyed": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "require_detection": {"type": "boolean"},
    "detected": {"type": "boolean"},
    "steps": {"type": "integer"}
  },
  "additionalProperties": false
}
