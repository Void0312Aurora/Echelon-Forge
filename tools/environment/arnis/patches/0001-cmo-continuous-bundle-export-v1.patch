+        }),
+    );
+    Ok(ArtifactDescriptor {
+        artifact_id: "artifact:landcover".to_string(),
+        kind: "landcover_raster".to_string(),
+        path: relative_path.to_string(),
+        sha256,
+        byte_length,
+        media_type: "application/vnd.arnis-cmo.raster-u8".to_string(),
+        dtype: Some("uint8".to_string()),
+        shape: Some([data.height, data.width]),
+        feature_class: None,
+        feature_count: None,
+        metadata,
+    })
+}
