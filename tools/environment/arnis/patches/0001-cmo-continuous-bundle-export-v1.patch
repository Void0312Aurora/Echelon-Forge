+fn write_feature_artifact(
+    output_root: &Path,
+    relative_path: &str,
+    feature_class: &str,
+    features: &[CmoFeature],
+) -> ExportResult<ArtifactDescriptor> {
+    let path = output_root.join(relative_path);
+    write_json(
+        &path,
+        &CmoFeatureFile {
+            schema: FEATURE_SCHEMA,
+            schema_version: FEATURE_SCHEMA_VERSION,
+            coordinate_frame: "local_enu_m",
+            feature_class,
+            features,
+        },
+    )?;
+    let (sha256, byte_length) = sha256_file(&path)?;
+    Ok(ArtifactDescriptor {
+        artifact_id: format!("artifact:{feature_class}"),
+        kind: "vector_features".to_string(),
+        path: relative_path.to_string(),
+        sha256,
+        byte_length,
+        media_type: "application/vnd.arnis-cmo.features+json".to_string(),
+        dtype: None,
+        shape: None,
+        feature_class: Some(feature_class.to_string()),
+        feature_count: Some(features.len()),
+        metadata: BTreeMap::from([(
+            "lineage".to_string(),
+            json!({
+                "representation": "continuous_metric_2_5d",
+                "source_stage": "projected_from_wgs84_f64",
+                "storage": "json_float64",
+                "quantization_step_m": null,
+                "block_projection_applied": false
+            }),
+        )]),
+    })
+}
