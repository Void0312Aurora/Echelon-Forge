+fn ensure_empty_output(output_root: &Path) -> ExportResult<()> {
+    if output_root.exists() {
+        if !output_root.is_dir() {
+            return Err(
+                format!("output path is not a directory: {}", output_root.display()).into(),
+            );
+        }
+        if fs::read_dir(output_root)?.next().is_some() {
+            return Err(format!(
+                "CMO output directory must be empty: {}",
+                output_root.display()
+            )
+            .into());
+        }
+    }
+    fs::create_dir_all(output_root.join("rasters"))?;
+    fs::create_dir_all(output_root.join("vectors"))?;
+    Ok(())
+}
+
+fn write_bundle_into(
+    elements: &[ProcessedElement],
+    llbbox: &LLBBox,
+    ground: &Ground,
+    suppression: &OutlineSuppression,
+    args: &Args,
+    output_root: &Path,
+) -> ExportResult<PathBuf> {
+    ensure_empty_output(output_root)?;
+    let elevation = ground
+        .elevation_data()
+        .ok_or("CMO export requires elevation data")?;
+    if let Some(required_provider) = args.cmo_require_elevation_provider.as_deref() {
+        if !has_exclusive_elevation_source(
+            &elevation.source_name,
+            &elevation.contributing_sources,
+            elevation.missing_source_units,
+            required_provider,
+        ) {
+            return Err(format!(
+                "required exclusive elevation provider '{required_provider}', but Arnis used primary '{}' with contributions {:?} and {} missing source units",
+                elevation.source_name,
+                elevation.contributing_sources,
+                elevation.missing_source_units,
+            )
+            .into());
+        }
+    }
+    let osm_path = Path::new(args.file.as_deref().ok_or("CMO export requires --file")?);
+    let (metric_geometry, osm_sha256, osm_byte_length) = load_metric_geometry(osm_path, llbbox)?;
+    let exporter_patch_sha256 = args
+        .cmo_exporter_patch_sha256
+        .as_deref()
+        .ok_or("CMO export requires --cmo-exporter-patch-sha256")?;
+    let source_key = sha256_bytes(
+        format!(
+            "{}|{:.8},{:.8},{:.8},{:.8}|{}",
+            osm_sha256,
+            llbbox.min().lat(),
+            llbbox.min().lng(),
+            llbbox.max().lat(),
+            llbbox.max().lng(),
+            elevation.source_name
+        )
+        .as_bytes(),
+    );
+    let tile_scheme_id = format!("arnis-{}", &source_key[..16]);
+    let tile_id = format!("tile:{tile_scheme_id}:r0000:c0000");
+    let (roads, buildings, hydrology) = extract_features(elements, suppression, &metric_geometry);
+    let mut artifacts = vec![
+        write_elevation_artifact(output_root, &metric_geometry.bounds, ground)?,
+        write_landcover_artifact(output_root, &metric_geometry.bounds, ground)?,
+        write_feature_artifact(output_root, "vectors/roads.cmo.json", "road", &roads)?,
+        write_feature_artifact(
+            output_root,
+            "vectors/buildings.cmo.json",
+            "building",
+            &buildings,
+        )?,
+        write_feature_artifact(
+            output_root,
+            "vectors/hydrology.cmo.json",
+            "hydrology",
+            &hydrology,
+        )?,
+    ];
+
+    let provenance = json!({
+        "contract_version": BUNDLE_CONTRACT_VERSION,
+        "exporter_version": EXPORTER_VERSION,
+        "exporter_patch_id": EXPORTER_PATCH_ID,
+        "exporter_patch_sha256": exporter_patch_sha256,
+        "generator": {
+            "id": "arnis",
+            "version": env!("CARGO_PKG_VERSION"),
+            "upstream_revision": ARNIS_UPSTREAM_REVISION
+        },
+        "source_inputs": [{
+            "kind": "osm_json",
+            "sha256": osm_sha256,
+            "byte_length": osm_byte_length,
+            "provider": "openstreetmap",
+            "tags_filtered_by_arnis": true
+        }],
+        "elevation": {
+            "primary_provider": elevation.source_name,
+            "contributing_sources": elevation.contributing_sources,
+            "missing_source_units": elevation.missing_source_units,
+            "source_mode": if args.aws_only_elevation { "aws_only" } else { "arnis_provider_selection" },
+            "semantics": "arnis_postprocessed_ground_surface",
+            "vertical_datum": "source_provider_native_unspecified"
+        },
+        "landcover": {
+            "provider": "ESA WorldCover",
+            "release": "2021 v200",
+            "semantics": "esa_worldcover_source_classification_metric_grid"
+        },
+        "processing": [
+            "osm_parse_and_tag_filter",
+            "elevation_outlier_filter",
+            "terrain_anomaly_repair",
+            "landcover_aware_elevation_repair"
+        ],
+        "coordinate_system": {
+            "coordinate_frame": "local_enu_m",
+            "source_projection": "arnis_local_web_mercator_r6371000_f64",
+            "origin_wgs84": {
+                "latitude": (llbbox.min().lat() + llbbox.max().lat()) / 2.0,
+                "longitude": (llbbox.min().lng() + llbbox.max().lng()) / 2.0
+            },
+            "axis_mapping": {"x": "east", "y": "north"},
+            "scale": 1.0,
+            "rotation_deg": 0.0
+        },
+        "lineage": continuous_lineage(),
+        "capability_boundary": {
+            "static_environment_data_only": true,
+            "no_runtime_setup_release": true,
+            "no_held_capability_release": true
+        }
+    });
+    let provenance_path = output_root.join("provenance.json");
+    write_json(&provenance_path, &provenance)?;
+    let (provenance_sha256, provenance_byte_length) = sha256_file(&provenance_path)?;
+    artifacts.push(ArtifactDescriptor {
+        artifact_id: "artifact:provenance".to_string(),
+        kind: "provenance".to_string(),
+        path: "provenance.json".to_string(),
+        sha256: provenance_sha256,
+        byte_length: provenance_byte_length,
+        media_type: "application/json".to_string(),
+        dtype: None,
+        shape: None,
+        feature_class: None,
+        feature_count: None,
+        metadata: BTreeMap::from([(
+            "lineage".to_string(),
+            json!({
+                "representation": "continuous_metric_2_5d",
+                "source_stage": "continuous_bundle_provenance",
+                "storage": "json",
+                "block_derived": false
+            }),
+        )]),
+    });
+    artifacts.sort_by(|left, right| left.path.cmp(&right.path));
+
+    let region_extent = json!({
+        "min_x": metric_geometry.bounds.min_x,
+        "min_y": metric_geometry.bounds.min_y,
+        "max_x": metric_geometry.bounds.max_x,
+        "max_y": metric_geometry.bounds.max_y
+    });
+    let content_digest = sha256_bytes(&serde_json::to_vec(&json!({
+        "artifacts": artifacts,
+        "region_extent": region_extent,
+        "source_key": source_key
+    }))?);
+    let bundle_id = format!("arnis-cmo-bundle:{}", &content_digest[..24]);
+    let bundle = json!({
+        "contract_version": BUNDLE_CONTRACT_VERSION,
+        "bundle_id": bundle_id,
+        "content_digest_sha256": content_digest,
+        "generator": {
+            "id": "arnis",
+            "version": env!("CARGO_PKG_VERSION"),
+            "upstream_revision": ARNIS_UPSTREAM_REVISION,
+            "exporter_version": EXPORTER_VERSION,
+            "exporter_patch_id": EXPORTER_PATCH_ID,
+            "exporter_patch_sha256": exporter_patch_sha256
+        },
+        "request": {
+            "request_id": format!("arnis-import:{}", &source_key[..24]),
+            "deterministic_seed": 0,
+            "source_input_sha256": osm_sha256,
+            "projection": "arnis_local_scaled_web_mercator_r6371000_normalized_to_local_enu",
+            "scale": 1.0,
+            "rotation_deg": 0.0,
+            "overture": false
+        },
+        "coordinate_frame": "local_enu_m",
+        "lineage": continuous_lineage(),
+        "bbox_wgs84": {
+            "min_lat": llbbox.min().lat(),
+            "min_lon": llbbox.min().lng(),
+            "max_lat": llbbox.max().lat(),
+            "max_lon": llbbox.max().lng()
+        },
+        "region_extent": region_extent,
+        "tile_scheme": {
+            "tile_scheme_id": tile_scheme_id,
+            "tile_id": tile_id,
+            "columns": 1,
+            "rows": 1,
+            "halo_m": 0.0
+        },
+        "artifacts": artifacts,
+        "capability_claims": [],
+        "no_held_capability_release": true
+    });
+    let bundle_path = output_root.join("bundle.json");
+    write_json(&bundle_path, &bundle)?;
+
+    let mut checksum_paths: Vec<String> = bundle["artifacts"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|artifact| artifact["path"].as_str().map(str::to_string))
+        .collect();
+    checksum_paths.push("bundle.json".to_string());
+    checksum_paths.sort();
+    let mut checksum_writer = BufWriter::new(File::create(output_root.join("checksums.sha256"))?);
+    for relative_path in checksum_paths {
+        let (sha256, _) = sha256_file(&output_root.join(&relative_path))?;
+        writeln!(checksum_writer, "{sha256}  {relative_path}")?;
+    }
+    checksum_writer.flush()?;
+    Ok(bundle_path)
+}
+
+pub fn export_bundle(
+    elements: &[ProcessedElement],
+    llbbox: &LLBBox,
+    ground: &Ground,
+    suppression: &OutlineSuppression,
+    args: &Args,
+    output_root: &Path,
+) -> ExportResult<PathBuf> {
+    if output_root.exists() {
+        if !output_root.is_dir() {
+            return Err(
+                format!("output path is not a directory: {}", output_root.display()).into(),
+            );
+        }
+        if fs::read_dir(output_root)?.next().is_some() {
+            return Err(format!(
+                "CMO output directory must be empty: {}",
+                output_root.display()
+            )
+            .into());
+        }
+    }
+    let output_name = output_root
+        .file_name()
+        .and_then(|value| value.to_str())
+        .ok_or("CMO output directory requires a portable final path component")?;
+    let parent = output_root.parent().unwrap_or_else(|| Path::new("."));
+    let staging_root = parent.join(format!(".{output_name}.cmo-staging-{}", std::process::id()));
+    if staging_root.exists() {
+        return Err(format!(
+            "CMO staging directory already exists: {}",
+            staging_root.display()
+        )
+        .into());
+    }
+    let write_result =
+        write_bundle_into(elements, llbbox, ground, suppression, args, &staging_root);
+    if let Err(error) = write_result {
+        let _ = fs::remove_dir_all(&staging_root);
+        return Err(error);
+    }
+    if output_root.exists() {
+        fs::remove_dir(output_root)?;
+    }
+    if let Err(error) = fs::rename(&staging_root, output_root) {
+        let _ = fs::remove_dir_all(&staging_root);
+        return Err(error.into());
+    }
+    Ok(output_root.join("bundle.json"))
+}
