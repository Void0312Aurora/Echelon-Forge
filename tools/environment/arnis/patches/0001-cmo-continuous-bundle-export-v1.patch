+
+fn ring_coordinates(nodes: &[MetricNode]) -> Option<Vec<[f64; 2]>> {
+    let mut points: Vec<[f64; 2]> = nodes.iter().map(|node| node.point).collect();
+    points.dedup();
+    if points.len() < 4 || points.first() != points.last() {
+        return None;
+    }
+    Some(points)
+}
+
+fn clip_polygon_edge<Inside, Intersect>(
+    input: &[[f64; 2]],
+    inside: Inside,
+    intersect: Intersect,
+) -> Vec<[f64; 2]>
+where
+    Inside: Fn([f64; 2]) -> bool,
+    Intersect: Fn([f64; 2], [f64; 2]) -> [f64; 2],
+{
+    if input.is_empty() {
+        return Vec::new();
+    }
+    let mut output = Vec::new();
+    let mut previous = *input.last().expect("non-empty polygon");
+    let mut previous_inside = inside(previous);
+    for &current in input {
+        let current_inside = inside(current);
+        if current_inside {
+            if !previous_inside {
+                output.push(intersect(previous, current));
+            }
+            output.push(current);
+        } else if previous_inside {
+            output.push(intersect(previous, current));
+        }
+        previous = current;
+        previous_inside = current_inside;
+    }
+    output
+}
+
+fn vertical_intersection(a: [f64; 2], b: [f64; 2], x: f64) -> [f64; 2] {
+    let delta = b[0] - a[0];
+    let t = if delta.abs() <= f64::EPSILON {
+        0.0
+    } else {
+        (x - a[0]) / delta
+    };
+    [x, a[1] + t * (b[1] - a[1])]
+}
+
+fn horizontal_intersection(a: [f64; 2], b: [f64; 2], y: f64) -> [f64; 2] {
+    let delta = b[1] - a[1];
+    let t = if delta.abs() <= f64::EPSILON {
+        0.0
+    } else {
+        (y - a[1]) / delta
+    };
+    [a[0] + t * (b[0] - a[0]), y]
+}
+
+fn clipped_ring_coordinates(nodes: &[MetricNode], bounds: &MetricBounds) -> Option<Vec<[f64; 2]>> {
+    let closed = ring_coordinates(nodes)?;
+    let mut points = closed[..closed.len() - 1].to_vec();
+    points = clip_polygon_edge(
+        &points,
+        |point| point[0] >= bounds.min_x,
+        |a, b| vertical_intersection(a, b, bounds.min_x),
+    );
+    points = clip_polygon_edge(
+        &points,
+        |point| point[0] <= bounds.max_x,
+        |a, b| vertical_intersection(a, b, bounds.max_x),
+    );
+    points = clip_polygon_edge(
+        &points,
+        |point| point[1] >= bounds.min_y,
+        |a, b| horizontal_intersection(a, b, bounds.min_y),
+    );
+    points = clip_polygon_edge(
+        &points,
+        |point| point[1] <= bounds.max_y,
+        |a, b| horizontal_intersection(a, b, bounds.max_y),
+    );
+    points.dedup();
+    if points.len() < 3 {
+        return None;
+    }
+    points.push(points[0]);
+    Some(points)
+}
+
+fn clip_segment_to_bounds(
+    start: [f64; 2],
+    end: [f64; 2],
+    bounds: &MetricBounds,
+) -> Option<([f64; 2], [f64; 2])> {
+    let dx = end[0] - start[0];
+    let dy = end[1] - start[1];
+    let p = [-dx, dx, -dy, dy];
+    let q = [
+        start[0] - bounds.min_x,
+        bounds.max_x - start[0],
+        start[1] - bounds.min_y,
+        bounds.max_y - start[1],
+    ];
+    let mut enter = 0.0_f64;
+    let mut leave = 1.0_f64;
+    for (denominator, numerator) in p.into_iter().zip(q) {
+        if denominator.abs() <= f64::EPSILON {
+            if numerator < 0.0 {
+                return None;
+            }
+            continue;
+        }
+        let ratio = numerator / denominator;
+        if denominator < 0.0 {
+            enter = enter.max(ratio);
+        } else {
+            leave = leave.min(ratio);
+        }
+        if enter > leave {
+            return None;
+        }
+    }
+    Some((
+        [start[0] + enter * dx, start[1] + enter * dy],
+        [start[0] + leave * dx, start[1] + leave * dy],
+    ))
+}
+
+fn clipped_line_coordinates(nodes: &[MetricNode], bounds: &MetricBounds) -> Vec<Vec<[f64; 2]>> {
+    let mut parts: Vec<Vec<[f64; 2]>> = Vec::new();
+    for pair in nodes.windows(2) {
+        let Some((start, end)) = clip_segment_to_bounds(pair[0].point, pair[1].point, bounds)
+        else {
+            continue;
+        };
+        if start == end {
+            continue;
+        }
+        if let Some(current) = parts.last_mut() {
+            if current.last().copied() == Some(start) {
+                current.push(end);
+                current.dedup();
+                continue;
+            }
+        }
+        parts.push(vec![start, end]);
+    }
+    parts.retain(|part| part.len() >= 2);
+    parts
+}
+
+fn merge_metric_way_segments(ways: &mut Vec<Vec<MetricNode>>) {
+    loop {
+        let mut merged = false;
+        'outer: for left_index in 0..ways.len() {
+            if ways[left_index].is_empty() {
+                continue;
+            }
+            for right_index in (left_index + 1)..ways.len() {
+                if ways[right_index].is_empty() {
+                    continue;
+                }
+                let left_first = ways[left_index].first().map(|node| node.id);
+                let left_last = ways[left_index].last().map(|node| node.id);
+                let right_first = ways[right_index].first().map(|node| node.id);
+                let right_last = ways[right_index].last().map(|node| node.id);
+                let mut right = ways.remove(right_index);
+                if left_last == right_first {
+                    right.remove(0);
+                    ways[left_index].extend(right);
+                } else if left_last == right_last {
+                    right.reverse();
+                    right.remove(0);
+                    ways[left_index].extend(right);
+                } else if left_first == right_last {
+                    right.pop();
+                    right.extend(ways[left_index].drain(..));
+                    ways[left_index] = right;
+                } else if left_first == right_first {
+                    right.reverse();
+                    right.pop();
+                    right.extend(ways[left_index].drain(..));
+                    ways[left_index] = right;
+                } else {
+                    ways.insert(right_index, right);
+                    continue;
+                }
+                merged = true;
+                break 'outer;
+            }
+        }
+        if !merged {
+            break;
+        }
+    }
+}
+
+fn parse_measure_m(value: &str) -> Option<f64> {
+    let first = value.split(';').next()?.trim();
+    let normalized = first
+        .strip_suffix("meters")
+        .or_else(|| first.strip_suffix("meter"))
+        .or_else(|| first.strip_suffix('m'))
+        .unwrap_or(first)
+        .trim();
+    normalized
+        .parse::<f64>()
+        .ok()
+        .filter(|number| number.is_finite() && *number > 0.0)
+}
+
+fn parse_nonnegative_measure_m(value: &str) -> Option<f64> {
+    let first = value.split(';').next()?.trim();
+    let normalized = first
+        .strip_suffix("meters")
+        .or_else(|| first.strip_suffix("meter"))
+        .or_else(|| first.strip_suffix('m'))
+        .unwrap_or(first)
+        .trim();
+    normalized
+        .parse::<f64>()
+        .ok()
+        .filter(|number| number.is_finite() && *number >= 0.0)
+}
+
+fn parse_numeric_tag(tags: &std::collections::HashMap<String, String>, key: &str) -> Option<f64> {
+    tags.get(key)
+        .and_then(|value| value.split(';').next())
+        .and_then(|value| value.trim().parse::<f64>().ok())
+        .filter(|value| value.is_finite())
+}
+
+fn parse_integer_tag(tags: &std::collections::HashMap<String, String>, key: &str) -> Option<i64> {
+    tags.get(key)
+        .and_then(|value| value.split(';').next())
+        .and_then(|value| value.trim().parse::<i64>().ok())
+}
+
+fn parse_nonnegative_level(
+    tags: &std::collections::HashMap<String, String>,
+    key: &str,
+) -> Option<f64> {
+    parse_numeric_tag(tags, key).filter(|value| *value >= 0.0)
+}
+
+fn parse_level(tags: &std::collections::HashMap<String, String>, key: &str) -> f64 {
+    tags.get(key)
+        .and_then(|value| value.parse::<f64>().ok())
+        .filter(|value| value.is_finite())
+        .unwrap_or(0.0)
+}
+
+fn base_provenance(
+    source_type: &str,
+    source_id: u64,
+    tags: &std::collections::HashMap<String, String>,
+) -> BTreeMap<String, Value> {
+    let mut provenance = BTreeMap::new();
+    provenance.insert("source_provider".to_string(), json!(source_provider(tags)));
+    provenance.insert("source_feature_type".to_string(), json!(source_type));
+    provenance.insert(
+        "source_feature_id".to_string(),
+        json!(source_id.to_string()),
+    );
+    provenance.insert("source_tags".to_string(), tags_value(tags));
+    provenance.insert("tags_filtered_by_arnis".to_string(), json!(true));
+    provenance
+}
+
+fn measurement_lineage(source: &str) -> Value {
+    json!({
+        "source_domain": "metric_semantics_pre_block_conversion",
+        "source_semantics": source,
+        "derived_from_block_count": false,
+        "derived_from_block_range": false
+    })
+}
+
+fn semantic_lineage(source: &str) -> Value {
+    json!({
+        "source_domain": "semantic_tags_pre_block_conversion",
+        "source_semantics": source,
+        "derived_from_block_count": false,
+        "derived_from_block_range": false
+    })
+}
