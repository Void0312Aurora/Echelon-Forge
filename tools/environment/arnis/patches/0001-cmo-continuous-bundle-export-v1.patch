+fn write_elevation_artifact(
+    output_root: &Path,
+    bounds: &MetricBounds,
+    ground: &Ground,
+) -> ExportResult<ArtifactDescriptor> {
+    let data = ground
+        .elevation_data()
+        .ok_or("CMO export requires successfully fetched elevation data")?;
+    let relative_path = "rasters/elevation.f32le";
+    let path = output_root.join(relative_path);
+    let metric_heights = data
+        .postprocessed_heights_m
+        .as_ref()
+        .ok_or("CMO export requires retained postprocessed metric DEM")?;
+    let mut writer = BufWriter::new(File::create(&path)?);
+    for row in metric_heights {
+        for &height_m in row {
+            writer.write_all(&height_m.to_le_bytes())?;
+        }
+    }
+    writer.flush()?;
+    let (sha256, byte_length) = sha256_file(&path)?;
+    let step_x = if data.width > 1 {
+        (bounds.max_x - bounds.min_x) / (data.width - 1) as f64
+    } else {
+        0.0
+    };
+    let step_y = if data.height > 1 {
+        (bounds.min_y - bounds.max_y) / (data.height - 1) as f64
+    } else {
+        0.0
+    };
+    let mut metadata = BTreeMap::new();
+    metadata.insert("grid_registration".to_string(), json!("point"));
+    metadata.insert(
+        "origin_xy_m".to_string(),
+        json!([bounds.min_x, bounds.max_y]),
+    );
+    metadata.insert("step_xy_m".to_string(), json!([step_x, step_y]));
+    metadata.insert("units".to_string(), json!("m"));
+    metadata.insert(
+        "vertical_datum".to_string(),
+        json!("source_provider_native_unspecified"),
+    );
+    metadata.insert("uncertainty_status".to_string(), json!("not_reported"));
+    metadata.insert(
+        "semantics".to_string(),
+        json!("arnis_postprocessed_ground_surface"),
+    );
+    metadata.insert(
+        "lineage".to_string(),
+        json!({
+            "representation": "continuous_metric_2_5d",
+            "source_stage": "postprocessed_metric_dem",
+            "storage": "float32_le",
+            "vertical_quantization_step_m": null,
+            "minecraft_y_transform_applied": false,
+            "minecraft_y_roundtrip": false
+        }),
+    );
+    metadata.insert(
+        "processing_stage".to_string(),
+        json!("postprocess_meters_pre_minecraft_scale"),
+    );
+    metadata.insert("minecraft_scaling_applied".to_string(), json!(false));
+    metadata.insert("source_provider".to_string(), json!(data.source_name));
+    metadata.insert(
+        "contributing_sources".to_string(),
+        json!(data.contributing_sources),
+    );
+    metadata.insert(
+        "missing_source_units".to_string(),
+        json!(data.missing_source_units),
+    );
+    metadata.insert(
+        "world_shape".to_string(),
+        json!([data.world_height, data.world_width]),
+    );
+    Ok(ArtifactDescriptor {
+        artifact_id: "artifact:elevation".to_string(),
+        kind: "elevation_raster".to_string(),
+        path: relative_path.to_string(),
+        sha256,
+        byte_length,
+        media_type: "application/vnd.arnis-cmo.raster-f32le".to_string(),
+        dtype: Some("float32_le".to_string()),
+        shape: Some([data.height, data.width]),
+        feature_class: None,
+        feature_count: None,
+        metadata,
+    })
+}
