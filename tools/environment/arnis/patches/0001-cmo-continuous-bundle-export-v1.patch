+fn has_exclusive_elevation_source(
+    primary_source: &str,
+    contributing_sources: &BTreeMap<String, usize>,
+    missing_source_units: usize,
+    required_source: &str,
+) -> bool {
+    primary_source == required_source
+        && missing_source_units == 0
+        && contributing_sources.len() == 1
+        && contributing_sources
+            .get(required_source)
+            .is_some_and(|count| *count > 0)
+}
