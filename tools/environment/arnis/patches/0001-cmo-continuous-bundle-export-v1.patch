+        assert_eq!(ground_road_feature.attributes["layer"], 0.0);
+
+        let positive_layer_road = ProcessedWay {
+            id: 5,
+            nodes: Vec::new(),
+            tags: HashMap::from([
+                ("highway".to_string(), "service".to_string()),
+                ("layer".to_string(), "1".to_string()),
+                ("tunnel".to_string(), "building_passage".to_string()),
+            ]),
+        };
+        let positive_layer_feature = &road_features(&positive_layer_road, &geometry)[0];
+        assert_eq!(
+            positive_layer_feature.attributes["vertical_anchor_mode"],
+            "elevated_profile"
+        );
+        assert_eq!(
+            positive_layer_feature.attributes["vertical_placement_resolved"],
+            false
+        );
+        assert_eq!(positive_layer_feature.attributes["tunnel"], true);
+
+        let building_passage = ProcessedWay {
+            id: 6,
+            nodes: Vec::new(),
+            tags: HashMap::from([
+                ("highway".to_string(), "service".to_string()),
+                ("tunnel".to_string(), "building_passage".to_string()),
+            ]),
+        };
+        let building_passage_feature = &road_features(&building_passage, &geometry)[0];
+        assert_eq!(
+            building_passage_feature.attributes["vertical_anchor_mode"],
+            "subsurface_profile"
+        );
+        assert_eq!(building_passage_feature.attributes["tunnel"], true);
+
+        let covered_road = ProcessedWay {
+            id: 7,
+            nodes: Vec::new(),
+            tags: HashMap::from([
+                ("highway".to_string(), "service".to_string()),
+                ("covered".to_string(), "arcade".to_string()),
+            ]),
+        };
+        let covered_feature = &road_features(&covered_road, &geometry)[0];
+        assert_eq!(
+            covered_feature.attributes["vertical_anchor_mode"],
+            "terrain_draped"
+        );
+        assert_eq!(
+            covered_feature.attributes["vertical_placement_resolved"],
+            true
+        );
+        assert_eq!(covered_feature.attributes["tunnel"], false);
+        assert_eq!(covered_feature.attributes["covered"], true);
+        assert_eq!(
+            covered_feature.lineage["measurements"]["covered"]["source_semantics"],
+            "osm_covered_semantic"
+        );
+
+        let invalid_layer_road = ProcessedWay {
+            id: 8,
+            nodes: Vec::new(),
+            tags: HashMap::from([
+                ("highway".to_string(), "service".to_string()),
+                ("layer".to_string(), "upper".to_string()),
+            ]),
+        };
+        let invalid_layer_feature = &road_features(&invalid_layer_road, &geometry)[0];
+        assert_eq!(invalid_layer_feature.attributes["layer"], "upper");
+        assert_eq!(
+            invalid_layer_feature.attributes["vertical_anchor_mode"],
+            "elevated_profile"
+        );
+        assert_eq!(
+            invalid_layer_feature.attributes["vertical_placement_resolved"],
+            false
+        );
+        assert_eq!(
+            invalid_layer_feature.lineage["measurements"]["layer"]["source_semantics"],
+            "invalid_osm_layer_raw_semantic"
+        );
+
+        let expected_road_measurements = BTreeSet::from([
+            "bridge",
+            "covered",
+            "layer",
+            "tunnel",
+            "vertical_anchor_mode",
+            "vertical_anchor_source",
+            "vertical_placement_resolved",
+            "width_m",
+        ]);
+        for feature in [
+            bridge_feature,
+            tunnel_feature,
+            ground_road_feature,
+            positive_layer_feature,
+            building_passage_feature,
+            covered_feature,
+            invalid_layer_feature,
+        ] {
+            let actual = feature.lineage["measurements"]
+                .as_object()
+                .unwrap()
+                .keys()
+                .map(String::as_str)
+                .collect::<BTreeSet<_>>();
+            assert_eq!(actual, expected_road_measurements);
+        }
+
+        let river = ProcessedWay {
+            id: 3,
+            nodes: Vec::new(),
+            tags: HashMap::from([("waterway".to_string(), "river".to_string())]),
+        };
+        let river_feature = &hydrology_features_from_way(&river, &geometry)[0];
+        assert_eq!(
+            river_feature.attributes["vertical_anchor_mode"],
+            "water_surface_from_dem"
+        );
+        assert_eq!(
+            river_feature.attributes["vertical_placement_resolved"],
+            true
+        );
+
+        for feature in [
+            bridge_feature,
+            tunnel_feature,
+            ground_road_feature,
+            positive_layer_feature,
+            building_passage_feature,
+            covered_feature,
+            invalid_layer_feature,
+            river_feature,
+        ] {
+            let measurements = &feature.lineage["measurements"];
+            for key in [
+                "vertical_anchor_mode",
+                "vertical_placement_resolved",
+                "vertical_anchor_source",
+            ] {
+                assert_eq!(measurements[key]["derived_from_block_count"], false);
+                assert_eq!(measurements[key]["derived_from_block_range"], false);
+            }
+        }
+    }
+
+    #[test]
+    fn continuous_lineage_explicitly_rejects_minecraft_roundtrips() {
+        let lineage = continuous_lineage();
+        assert_eq!(lineage["contract"], "arnis_continuous_metric.v1");
+        assert_eq!(lineage["geometry"]["block_projection_applied"], false);
+        assert_eq!(lineage["elevation"]["minecraft_y_roundtrip"], false);
+        assert_eq!(lineage["voxelization_applied"], false);
+    }
+
+    #[test]
+    fn point_in_ring_assigns_holes() {
+        let outer = vec![
+            [0.0, 0.0],
+            [10.0, 0.0],
+            [10.0, 10.0],
+            [0.0, 10.0],
+            [0.0, 0.0],
+        ];
+        assert!(point_in_ring([5.0, 5.0], &outer));
+        assert!(!point_in_ring([15.0, 5.0], &outer));
+    }
+
+    #[test]
+    fn exclusive_elevation_source_rejects_fallback_or_missing_units() {
+        let usgs_only = BTreeMap::from([("usgs_3dep".to_string(), 2)]);
+        assert!(has_exclusive_elevation_source(
+            "usgs_3dep",
+            &usgs_only,
+            0,
+            "usgs_3dep"
+        ));
+        let mixed = BTreeMap::from([("aws_terrain".to_string(), 1), ("usgs_3dep".to_string(), 1)]);
+        assert!(!has_exclusive_elevation_source(
+            "usgs_3dep",
+            &mixed,
+            0,
+            "usgs_3dep"
+        ));
+        assert!(!has_exclusive_elevation_source(
+            "usgs_3dep",
+            &usgs_only,
+            1,
+            "usgs_3dep"
+        ));
+    }
+}
