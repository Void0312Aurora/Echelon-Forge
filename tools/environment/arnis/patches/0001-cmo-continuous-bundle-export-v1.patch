+
+fn road_width_m(
+    highway_type: &str,
+    tags: &std::collections::HashMap<String, String>,
+) -> (f64, &'static str) {
+    if let Some(width) = tags.get("width").and_then(|value| parse_measure_m(value)) {
+        return (width, "osm_width_m");
+    }
+    if let Some(lanes) = tags
+        .get("lanes")
+        .and_then(|value| value.split(';').next())
+        .and_then(|value| value.trim().parse::<f64>().ok())
+        .filter(|value| value.is_finite() && *value > 0.0)
+    {
+        return (lanes * METERS_PER_ROAD_LANE, "osm_lanes_times_3_2m");
+    }
+    let width = match highway_type {
+        "motorway" => 12.0,
+        "trunk" => 10.0,
+        "motorway_link" | "trunk_link" => 7.0,
+        "primary" | "secondary" => 8.0,
+        "primary_link" | "secondary_link" | "tertiary" => 7.0,
+        "tertiary_link" | "residential" | "unclassified" | "service" => 5.5,
+        "living_street" => 4.0,
+        "pedestrian" => 3.0,
+        "cycleway" | "footway" | "path" | "steps" | "track" => 2.0,
+        _ => 5.0,
+    };
+    (width, "cmo_metric_default_by_highway_class")
+}
+
+fn road_features(way: &ProcessedWay, geometry: &MetricGeometryIndex) -> Vec<CmoFeature> {
+    let Some(highway_type) = way.tags.get("highway") else {
+        return Vec::new();
+    };
+    let Some(nodes) = geometry.ways.get(&way.id) else {
+        return Vec::new();
+    };
+    let (width_m, width_source) = road_width_m(highway_type, &way.tags);
+    let bridge = matches!(
+        way.tags.get("bridge").map(String::as_str),
+        Some(value) if value != "no"
+    );
+    let explicit_tunnel = matches!(
+        way.tags.get("tunnel").map(String::as_str),
+        Some(value) if !value.eq_ignore_ascii_case("no") && !value.eq_ignore_ascii_case("false")
+    );
+    let covered = matches!(
+        way.tags.get("covered").map(String::as_str),
+        Some(value) if !value.eq_ignore_ascii_case("no") && !value.eq_ignore_ascii_case("false")
+    );
+    let parsed_layer = parse_numeric_tag(&way.tags, "layer");
+    let layer = parsed_layer.unwrap_or(0.0);
+    let layer_is_valid = parsed_layer.is_some() || !way.tags.contains_key("layer");
+    let (vertical_anchor_mode, vertical_placement_source) = if bridge || layer > 0.0 {
+        (
+            "elevated_profile",
+            "osm_bridge_or_positive_layer_requires_metric_elevated_profile",
+        )
+    } else if explicit_tunnel {
+        (
+            "subsurface_profile",
+            "osm_tunnel_requires_metric_subsurface_profile",
+        )
+    } else if layer < 0.0 {
+        (
+            "subsurface_profile",
+            "osm_negative_layer_requires_metric_subsurface_profile",
+        )
+    } else if !layer_is_valid {
+        (
+            "elevated_profile",
+            "unresolved_non_numeric_osm_layer_requires_metric_profile",
+        )
+    } else {
+        ("terrain_draped", "continuous_dem_draped_road_geometry")
+    };
+    let vertical_placement_resolved = vertical_anchor_mode == "terrain_draped";
+    clipped_line_coordinates(nodes, &geometry.bounds)
+        .into_iter()
+        .enumerate()
+        .map(|(part_index, points)| {
+            let mut attributes = BTreeMap::new();
+            attributes.insert("highway_type".to_string(), json!(highway_type));
+            attributes.insert("width_m".to_string(), json!(width_m));
+            attributes.insert("width_source".to_string(), json!(width_source));
+            attributes.insert(
+                "surface_class".to_string(),
+                json!(way
+                    .tags
+                    .get("surface")
+                    .map(String::as_str)
+                    .unwrap_or("unspecified")),
+            );
+            attributes.insert("connectivity".to_string(), json!("source_geometry"));
+            attributes.insert("bridge".to_string(), json!(bridge));
+            attributes.insert("tunnel".to_string(), json!(explicit_tunnel));
+            attributes.insert("covered".to_string(), json!(covered));
+            let layer_value = match parsed_layer {
+                Some(layer) => json!(layer),
+                None => way
+                    .tags
+                    .get("layer")
+                    .map_or_else(|| json!(0.0), |raw| json!(raw)),
+            };
+            attributes.insert("layer".to_string(), layer_value);
+            attributes.insert(
+                "vertical_anchor_mode".to_string(),
+                json!(vertical_anchor_mode),
+            );
+            attributes.insert(
+                "vertical_placement_resolved".to_string(),
+                json!(vertical_placement_resolved),
+            );
+            attributes.insert(
+                "vertical_anchor_source".to_string(),
+                json!(vertical_placement_source),
+            );
+            let layer_source = match (way.tags.contains_key("layer"), parsed_layer.is_some()) {
+                (true, true) => "osm_layer_semantic",
+                (true, false) => "invalid_osm_layer_raw_semantic",
+                (false, _) => "implicit_osm_layer_zero",
+            };
+            let bridge_source = if way.tags.contains_key("bridge") {
+                "osm_bridge_semantic"
+            } else {
+                "implicit_osm_bridge_false"
+            };
+            let tunnel_source = if explicit_tunnel {
+                "osm_tunnel_semantic"
+            } else if way.tags.contains_key("tunnel") {
+                "explicit_osm_tunnel_false"
+            } else {
+                "implicit_osm_tunnel_false"
+            };
+            let covered_source = if covered {
+                "osm_covered_semantic"
+            } else if way.tags.contains_key("covered") {
+                "explicit_osm_covered_false"
+            } else {
+                "implicit_osm_covered_false"
+            };
+            let measurements = BTreeMap::from([
+                ("width_m".to_string(), measurement_lineage(width_source)),
+                ("layer".to_string(), semantic_lineage(layer_source)),
+                ("bridge".to_string(), semantic_lineage(bridge_source)),
+                ("tunnel".to_string(), semantic_lineage(tunnel_source)),
+                ("covered".to_string(), semantic_lineage(covered_source)),
+                (
+                    "vertical_anchor_mode".to_string(),
+                    semantic_lineage(vertical_placement_source),
+                ),
+                (
+                    "vertical_placement_resolved".to_string(),
+                    semantic_lineage(vertical_placement_source),
+                ),
+                (
+                    "vertical_anchor_source".to_string(),
+                    semantic_lineage(vertical_placement_source),
+                ),
+            ]);
+            CmoFeature {
+                feature_id: format!(
+                    "{}:way:{}:road:part:{part_index:04}",
+                    source_provider(&way.tags),
+                    way.id
+                ),
+                geometry: FeatureGeometry {
+                    r#type: "LineString".to_string(),
+                    coordinates: json!(points),
+                },
+                attributes,
+                provenance: base_provenance("way", way.id, &way.tags),
+                lineage: feature_lineage(measurements),
+            }
+        })
+        .collect()
+}
+
+struct BuildingVerticalPlacement {
+    anchor_mode: &'static str,
+    resolved: bool,
+    base_offset_m: Option<f64>,
+    layer: Option<i64>,
+    source: &'static str,
+}
+
+fn building_vertical_placement(
+    tags: &std::collections::HashMap<String, String>,
+) -> BuildingVerticalPlacement {
+    let layer = parse_integer_tag(tags, "layer");
+    if let Some(base_offset_m) = tags
+        .get("min_height")
+        .and_then(|value| parse_nonnegative_measure_m(value))
+    {
+        return BuildingVerticalPlacement {
+            anchor_mode: "terrain_rigid",
+            resolved: true,
+            base_offset_m: Some(base_offset_m),
+            layer,
+            source: "osm_min_height_m",
+        };
+    }
+    if let Some(min_level) = parse_nonnegative_level(tags, "building:min_level") {
+        return BuildingVerticalPlacement {
+            anchor_mode: "terrain_rigid",
+            resolved: true,
+            base_offset_m: Some(min_level * METERS_PER_BUILDING_LEVEL),
+            layer,
+            source: "osm_building_min_level_times_3m",
+        };
+    }
+    if let Some(min_level) = parse_nonnegative_level(tags, "min_level") {
+        return BuildingVerticalPlacement {
+            anchor_mode: "terrain_rigid",
+            resolved: true,
+            base_offset_m: Some(min_level * METERS_PER_BUILDING_LEVEL),
+            layer,
+            source: "osm_min_level_times_3m",
+        };
+    }
+
+    let is_building_part = tags.contains_key("building:part")
+        || tags.get("building").map(String::as_str) == Some("roof");
+    if is_building_part && layer.is_some_and(|value| value > 0) {
+        return BuildingVerticalPlacement {
+            anchor_mode: "elevated_profile",
+            resolved: false,
+            base_offset_m: None,
+            layer,
+            source: "unresolved_positive_layer_without_metric_base_offset",
+        };
+    }
+
+    BuildingVerticalPlacement {
+        anchor_mode: "terrain_rigid",
+        resolved: true,
+        base_offset_m: Some(0.0),
+        layer,
+        source: "implicit_terrain_base_zero_m",
+    }
+}
+
+fn insert_building_vertical_placement(
+    attributes: &mut BTreeMap<String, Value>,
+    measurements: &mut BTreeMap<String, Value>,
+    placement: &BuildingVerticalPlacement,
+) {
+    attributes.insert(
+        "vertical_anchor_mode".to_string(),
+        json!(placement.anchor_mode),
+    );
+    attributes.insert(
+        "vertical_placement_resolved".to_string(),
+        json!(placement.resolved),
+    );
+    attributes.insert(
+        "vertical_anchor_source".to_string(),
+        json!(placement.source),
+    );
+    measurements.insert(
+        "vertical_anchor_mode".to_string(),
+        semantic_lineage(placement.source),
+    );
+    measurements.insert(
+        "vertical_placement_resolved".to_string(),
+        semantic_lineage(placement.source),
+    );
+    if placement.resolved {
+        let base_offset_m = placement
+            .base_offset_m
+            .expect("resolved building placement must have a metric base offset");
+        attributes.insert("base_offset_m".to_string(), json!(base_offset_m));
+        attributes.insert("base_offset_source".to_string(), json!(placement.source));
+        measurements.insert(
+            "base_offset_m".to_string(),
+            measurement_lineage(placement.source),
+        );
+        measurements.insert(
+            "base_offset_source".to_string(),
+            semantic_lineage(placement.source),
+        );
+    }
+    measurements.insert(
+        "vertical_anchor_source".to_string(),
+        semantic_lineage(placement.source),
+    );
+    if let Some(layer) = placement.layer {
+        attributes.insert("layer".to_string(), json!(layer));
+        measurements.insert("layer".to_string(), semantic_lineage("osm_layer_semantic"));
+    }
+}
+
+struct MetricBuildingHeight {
+    meters: f64,
+    source: &'static str,
+    semantics: &'static str,
+}
+
+fn metric_building_height(
+    tags: &std::collections::HashMap<String, String>,
+) -> Option<MetricBuildingHeight> {
+    let building_type = tags
+        .get("building")
+        .or_else(|| tags.get("building:part"))
+        .map(String::as_str)
+        .unwrap_or("yes");
+    if building_type == "bridge" {
+        return None;
+    }
+    let min_height = tags
+        .get("min_height")
+        .and_then(|value| parse_measure_m(value))
+        .unwrap_or(0.0);
+    let is_roof =
+        tags.get("building:part").map(String::as_str) == Some("roof") || building_type == "roof";
+    if is_roof {
+        if let Some(height) = tags
+            .get("roof:height")
+            .and_then(|value| parse_measure_m(value))
+        {
+            return Some(MetricBuildingHeight {
+                meters: height,
+                source: "osm_roof_height_m",
+                semantics: "physical_roof_thickness_m",
+            });
+        }
+        if let Some(total_height) = tags.get("height").and_then(|value| parse_measure_m(value)) {
+            return Some(MetricBuildingHeight {
+                meters: (total_height - min_height).max(0.1),
+                source: "osm_height_minus_min_height_m",
+                semantics: "physical_roof_thickness_m",
+            });
+        }
+        return Some(MetricBuildingHeight {
+            meters: 0.5,
+            source: "cmo_metric_default_roof_thickness",
+            semantics: "physical_roof_thickness_m",
+        });
+    }
+    if let Some(total_height) = tags.get("height").and_then(|value| parse_measure_m(value)) {
+        return Some(MetricBuildingHeight {
+            meters: (total_height - min_height).max(0.1),
+            source: "osm_height_minus_min_height_m",
+            semantics: "physical_vertical_extent_m",
+        });
+    }
+    let levels = parse_level(tags, "building:levels");
+    let min_level = parse_level(tags, "building:min_level").max(parse_level(tags, "min_level"));
+    if levels > min_level {
+        return Some(MetricBuildingHeight {
+            meters: (levels - min_level) * METERS_PER_BUILDING_LEVEL,
+            source: "osm_building_levels_times_3m",
+            semantics: "physical_vertical_extent_m",
+        });
+    }
+    let meters = if tags.get("amenity").map(String::as_str) == Some("shelter") {
+        3.0
+    } else {
+        match building_type {
+            "garage" | "garages" | "carport" | "shed" => 3.0,
+            "parking" => 12.0,
+            "apartments" => 9.0,
+            "hospital" => 12.0,
+            _ => 6.0,
+        }
+    };
+    Some(MetricBuildingHeight {
+        meters,
+        source: "cmo_metric_default_by_building_class",
+        semantics: "physical_vertical_extent_m",
+    })
+}
+
+fn building_feature_from_way(
+    way: &ProcessedWay,
+    relation_id: Option<u64>,
+    part_index: Option<usize>,
+    geometry: &MetricGeometryIndex,
+) -> Option<CmoFeature> {
+    if !way.tags.contains_key("building")
+        && !way.tags.contains_key("building:part")
+        && relation_id.is_none()
+    {
+        return None;
+    }
+    let ring = clipped_ring_coordinates(geometry.ways.get(&way.id)?, &geometry.bounds)?;
+    let height = metric_building_height(&way.tags)?;
+    let material = way
+        .tags
+        .get("building:material")
+        .or_else(|| way.tags.get("material"))
+        .map(String::as_str)
+        .unwrap_or("unspecified");
+    let mut attributes = BTreeMap::new();
+    attributes.insert("footprint".to_string(), json!("polygon"));
+    attributes.insert("height_m".to_string(), json!(height.meters));
+    attributes.insert("height_source".to_string(), json!(height.source));
+    attributes.insert("height_semantics".to_string(), json!(height.semantics));
+    attributes.insert("material".to_string(), json!(material));
+    attributes.insert(
+        "building_type".to_string(),
+        json!(way
+            .tags
+            .get("building")
+            .or_else(|| way.tags.get("building:part"))
+            .map(String::as_str)
+            .unwrap_or("yes")),
+    );
+    let placement = building_vertical_placement(&way.tags);
+    let mut measurements =
+        BTreeMap::from([("height_m".to_string(), measurement_lineage(height.source))]);
+    insert_building_vertical_placement(&mut attributes, &mut measurements, &placement);
+    let suffix = match (relation_id, part_index) {
+        (Some(relation_id), Some(index)) => format!("relation:{relation_id}:part:{index:04}"),
+        _ => format!("way:{}", way.id),
+    };
+    let mut provenance = base_provenance("way", way.id, &way.tags);
+    if let Some(relation_id) = relation_id {
+        provenance.insert(
+            "source_relation_id".to_string(),
+            json!(relation_id.to_string()),
+        );
+        provenance.insert("source_member_role".to_string(), json!("part"));
+    }
+    Some(CmoFeature {
+        feature_id: format!("{}:{suffix}:building", source_provider(&way.tags)),
+        geometry: FeatureGeometry {
+            r#type: "Polygon".to_string(),
+            coordinates: json!([ring]),
+        },
+        attributes,
+        provenance,
+        lineage: feature_lineage(measurements),
+    })
+}
+
+fn water_kind(tags: &std::collections::HashMap<String, String>) -> Option<String> {
+    if let Some(value) = tags.get("waterway") {
+        return Some(value.clone());
+    }
+    if let Some(value) = tags.get("water") {
+        return Some(value.clone());
+    }
+    if let Some(value) = tags.get("natural") {
+        if matches!(value.as_str(), "water" | "bay" | "wetland") {
+            return Some(value.clone());
+        }
+    }
+    if tags.get("landuse").map(String::as_str) == Some("reservoir") {
+        return Some("reservoir".to_string());
+    }
+    None
+}
