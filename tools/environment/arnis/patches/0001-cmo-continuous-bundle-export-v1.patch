+}
+
+#[derive(Serialize)]
+struct CmoFeatureFile<'a> {
+    schema: &'static str,
+    schema_version: u32,
+    coordinate_frame: &'static str,
+    feature_class: &'a str,
+    features: &'a [CmoFeature],
+}
+
+#[derive(Clone, Serialize)]
+struct ArtifactDescriptor {
+    artifact_id: String,
+    kind: String,
+    path: String,
+    sha256: String,
+    byte_length: u64,
+    media_type: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    dtype: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    shape: Option<[usize; 2]>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    feature_class: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    feature_count: Option<usize>,
+    metadata: BTreeMap<String, Value>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct MetricNode {
+    id: u64,
+    point: [f64; 2],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct MetricBounds {
+    min_x: f64,
+    min_y: f64,
+    max_x: f64,
+    max_y: f64,
+}
+
+impl MetricBounds {
+    fn from_bbox(bbox: &LLBBox, projection: &WebMercatorProjection, northing_scale: f64) -> Self {
+        let corners = [
+            (bbox.min().lat(), bbox.min().lng()),
+            (bbox.min().lat(), bbox.max().lng()),
+            (bbox.max().lat(), bbox.min().lng()),
+            (bbox.max().lat(), bbox.max().lng()),
+        ];
+        let mut min_x = f64::INFINITY;
+        let mut min_y = f64::INFINITY;
+        let mut max_x = f64::NEG_INFINITY;
+        let mut max_y = f64::NEG_INFINITY;
+        for (lat, lon) in corners {
+            let (x, z) = projection.forward(lat, lon);
+            let y = -z * northing_scale;
+            min_x = min_x.min(x);
+            min_y = min_y.min(y);
+            max_x = max_x.max(x);
+            max_y = max_y.max(y);
+        }
+        Self {
+            min_x,
+            min_y,
+            max_x,
+            max_y,
+        }
+    }
+}
+
+struct MetricGeometryIndex {
+    ways: HashMap<u64, Vec<MetricNode>>,
+    bounds: MetricBounds,
+}
+
+#[derive(Deserialize)]
+struct RawOsmDocument {
+    elements: Vec<RawOsmElement>,
+}
+
+#[derive(Deserialize)]
+struct RawOsmElement {
+    #[serde(rename = "type")]
+    element_type: String,
+    id: u64,
+    lat: Option<f64>,
+    lon: Option<f64>,
+    nodes: Option<Vec<u64>>,
+}
+
+struct HashingReader<R> {
+    inner: R,
+    digest: Sha256,
+    byte_length: u64,
+}
+
+impl<R> HashingReader<R> {
+    fn new(inner: R) -> Self {
+        Self {
+            inner,
+            digest: Sha256::new(),
+            byte_length: 0,
+        }
+    }
+
+    fn finish(self) -> (String, u64) {
+        (format!("{:x}", self.digest.finalize()), self.byte_length)
+    }
+}
+
+impl<R: Read> Read for HashingReader<R> {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        let read = self.inner.read(buffer)?;
+        self.digest.update(&buffer[..read]);
+        self.byte_length += read as u64;
+        Ok(read)
+    }
+}
+
+fn load_metric_geometry(
+    path: &Path,
+    bbox: &LLBBox,
+) -> ExportResult<(MetricGeometryIndex, String, u64)> {
+    let file = File::open(path)?;
+    let mut reader = HashingReader::new(BufReader::new(file));
+    let document: RawOsmDocument = serde_json::from_reader(&mut reader)?;
+    let (sha256, byte_length) = reader.finish();
+    let origin_lat = (bbox.min().lat() + bbox.max().lat()) / 2.0;
+    let origin_lon = (bbox.min().lng() + bbox.max().lng()) / 2.0;
+    let projection = WebMercatorProjection::new(origin_lat, origin_lon, 1.0);
+    let northing_scale = origin_lat.to_radians().cos();
+    let bounds = MetricBounds::from_bbox(bbox, &projection, northing_scale);
+    let mut nodes = HashMap::new();
+    for element in &document.elements {
+        if element.element_type != "node" || nodes.contains_key(&element.id) {
+            continue;
+        }
+        let (Some(lat), Some(lon)) = (element.lat, element.lon) else {
+            continue;
+        };
+        let (x, z) = projection.forward(lat, lon);
+        nodes.insert(
+            element.id,
+            MetricNode {
+                id: element.id,
+                point: [x, -z * northing_scale],
+            },
+        );
+    }
+    let mut ways = HashMap::new();
+    for element in &document.elements {
+        if element.element_type != "way" || ways.contains_key(&element.id) {
+            continue;
+        }
+        let Some(node_ids) = &element.nodes else {
+            continue;
+        };
+        let metric_nodes: Vec<MetricNode> = node_ids
+            .iter()
+            .filter_map(|node_id| nodes.get(node_id).copied())
+            .collect();
+        if metric_nodes.len() >= 2 {
+            ways.insert(element.id, metric_nodes);
+        }
+    }
+    Ok((MetricGeometryIndex { ways, bounds }, sha256, byte_length))
+}
