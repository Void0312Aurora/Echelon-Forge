+fn is_water_area(tags: &std::collections::HashMap<String, String>) -> bool {
+    matches!(
+        tags.get("natural").map(String::as_str),
+        Some("water" | "bay" | "wetland")
+    ) || tags.contains_key("water")
+        || tags.get("landuse").map(String::as_str) == Some("reservoir")
+        || matches!(
+            tags.get("waterway").map(String::as_str),
+            Some("riverbank" | "dock")
+        )
+}
+
+fn waterway_width_m(kind: &str) -> f64 {
+    match kind {
+        "river" => 12.0,
+        "canal" => 8.0,
+        "stream" => 3.0,
+        "ditch" | "drain" => 1.5,
+        _ => 2.0,
+    }
+}
+
+fn hydrology_features_from_way(
+    way: &ProcessedWay,
+    geometry: &MetricGeometryIndex,
+) -> Vec<CmoFeature> {
+    let Some(kind) = water_kind(&way.tags) else {
+        return Vec::new();
+    };
+    let Some(nodes) = geometry.ways.get(&way.id) else {
+        return Vec::new();
+    };
+    let area = is_water_area(&way.tags);
+    let geometries: Vec<FeatureGeometry> = if area {
+        let Some(ring) = clipped_ring_coordinates(nodes, &geometry.bounds) else {
+            return Vec::new();
+        };
+        vec![FeatureGeometry {
+            r#type: "Polygon".to_string(),
+            coordinates: json!([ring]),
+        }]
+    } else {
+        clipped_line_coordinates(nodes, &geometry.bounds)
+            .into_iter()
+            .map(|points| FeatureGeometry {
+                r#type: "LineString".to_string(),
+                coordinates: json!(points),
+            })
+            .collect()
+    };
+    let explicit_width = way
+        .tags
+        .get("width")
+        .and_then(|value| parse_measure_m(value));
+    geometries
+        .into_iter()
+        .enumerate()
+        .map(|(part_index, feature_geometry)| {
+            let mut attributes = BTreeMap::new();
+            attributes.insert("state".to_string(), json!("static_source_geometry"));
+            attributes.insert("water_kind".to_string(), json!(kind));
+            attributes.insert(
+                "geometry_role".to_string(),
+                json!(if area { "area" } else { "centerline" }),
+            );
+            let mut measurements = BTreeMap::new();
+            insert_hydrology_vertical_placement(&mut attributes, &mut measurements);
+            if !area {
+                let width_source = if explicit_width.is_some() {
+                    "osm_width_m"
+                } else {
+                    "cmo_metric_default_by_waterway_class"
+                };
+                attributes.insert(
+                    "width_m".to_string(),
+                    json!(explicit_width.unwrap_or_else(|| waterway_width_m(&kind))),
+                );
+                attributes.insert("width_source".to_string(), json!(width_source));
+                measurements.insert("width_m".to_string(), measurement_lineage(width_source));
+            }
+            CmoFeature {
+                feature_id: format!(
+                    "{}:way:{}:hydrology:part:{part_index:04}",
+                    source_provider(&way.tags),
+                    way.id
+                ),
+                geometry: feature_geometry,
+                attributes,
+                provenance: base_provenance("way", way.id, &way.tags),
+                lineage: feature_lineage(measurements),
+            }
+        })
+        .collect()
+}
+
+fn point_in_ring(point: [f64; 2], ring: &[[f64; 2]]) -> bool {
+    if ring.len() < 4 {
+        return false;
+    }
+    let mut inside = false;
+    let mut previous = ring.len() - 1;
+    for current in 0..ring.len() {
+        let a = ring[current];
+        let b = ring[previous];
+        let crosses = ((a[1] > point[1]) != (b[1] > point[1]))
+            && (point[0] < (b[0] - a[0]) * (point[1] - a[1]) / (b[1] - a[1]) + a[0]);
+        if crosses {
+            inside = !inside;
+        }
+        previous = current;
+    }
+    inside
+}
+
+fn ring_area_abs(ring: &[[f64; 2]]) -> f64 {
+    if ring.len() < 4 {
+        return 0.0;
+    }
+    0.5 * ring
+        .windows(2)
+        .map(|pair| pair[0][0] * pair[1][1] - pair[1][0] * pair[0][1])
+        .sum::<f64>()
+        .abs()
+}
+
+fn assembled_relation_polygons(
+    relation: &ProcessedRelation,
+    include_parts: bool,
+    geometry: &MetricGeometryIndex,
+) -> Vec<(Vec<[f64; 2]>, Vec<Vec<[f64; 2]>>)> {
+    let mut outers: Vec<Vec<MetricNode>> = relation
+        .members
+        .iter()
+        .filter(|member| {
+            matches!(member.role, ProcessedMemberRole::Outer)
+                || (include_parts && matches!(member.role, ProcessedMemberRole::Part))
+        })
+        .filter_map(|member| geometry.ways.get(&member.way.id).cloned())
+        .collect();
+    let mut inners: Vec<Vec<MetricNode>> = relation
+        .members
+        .iter()
+        .filter(|member| matches!(member.role, ProcessedMemberRole::Inner))
+        .filter_map(|member| geometry.ways.get(&member.way.id).cloned())
+        .collect();
+    merge_metric_way_segments(&mut outers);
+    merge_metric_way_segments(&mut inners);
+    let mut polygons: Vec<(Vec<[f64; 2]>, Vec<Vec<[f64; 2]>>)> = outers
+        .into_iter()
+        .filter_map(|ring| {
+            clipped_ring_coordinates(&ring, &geometry.bounds).map(|clipped| (clipped, Vec::new()))
+        })
+        .collect();
+    let inner_rings: Vec<Vec<[f64; 2]>> = inners
+        .into_iter()
+        .filter_map(|ring| clipped_ring_coordinates(&ring, &geometry.bounds))
+        .collect();
+    for inner in inner_rings {
+        let Some(point) = inner.first().copied() else {
+            continue;
+        };
+        let target = polygons
+            .iter()
+            .enumerate()
+            .filter(|(_, (outer, _))| point_in_ring(point, outer))
+            .min_by(|(_, (left, _)), (_, (right, _))| {
+                ring_area_abs(left).total_cmp(&ring_area_abs(right))
+            })
+            .map(|(index, _)| index);
+        if let Some(index) = target {
+            polygons[index].1.push(inner);
+        }
+    }
+    polygons.sort_by(|left, right| {
+        let left_key = left.0.first().copied().unwrap_or([0.0, 0.0]);
+        let right_key = right.0.first().copied().unwrap_or([0.0, 0.0]);
+        left_key[0]
+            .total_cmp(&right_key[0])
+            .then(left_key[1].total_cmp(&right_key[1]))
+    });
+    polygons
+}
+
+fn is_building_relation(relation: &ProcessedRelation) -> bool {
+    relation.tags.contains_key("building")
+        || relation.tags.get("type").map(String::as_str) == Some("building")
+        || relation.members.iter().any(|member| {
+            member.way.tags.contains_key("building")
+                || member.way.tags.contains_key("building:part")
+        })
+}
+
+fn building_features_from_relation(
+    relation: &ProcessedRelation,
+    geometry: &MetricGeometryIndex,
+) -> Vec<CmoFeature> {
+    if !is_building_relation(relation) {
+        return Vec::new();
+    }
+    let part_members: Vec<_> = relation
+        .members
+        .iter()
+        .filter(|member| matches!(member.role, ProcessedMemberRole::Part))
+        .collect();
+    if !part_members.is_empty() {
+        return part_members
+            .into_iter()
+            .enumerate()
+            .filter_map(|(index, member)| {
+                let mut merged_tags = relation.tags.clone();
+                merged_tags.extend(member.way.tags.clone());
+                let merged_way = ProcessedWay {
+                    id: member.way.id,
+                    nodes: member.way.nodes.clone(),
+                    tags: merged_tags,
+                };
+                let mut feature = building_feature_from_way(
+                    &merged_way,
+                    Some(relation.id),
+                    Some(index),
+                    geometry,
+                )?;
+                feature
+                    .provenance
+                    .insert("source_tags".to_string(), tags_value(&member.way.tags));
+                feature.provenance.insert(
+                    "inherited_relation_tags".to_string(),
+                    tags_value(&relation.tags),
+                );
+                Some(feature)
+            })
+            .collect();
+    }
+
+    let polygons = assembled_relation_polygons(relation, false, geometry);
+    polygons
+        .into_iter()
+        .enumerate()
+        .filter_map(|(index, (outer, holes))| {
+            let mut attributes = BTreeMap::new();
+            let height = metric_building_height(&relation.tags)?;
+            attributes.insert("footprint".to_string(), json!("polygon"));
+            attributes.insert("height_m".to_string(), json!(height.meters));
+            attributes.insert("height_source".to_string(), json!(height.source));
+            attributes.insert("height_semantics".to_string(), json!(height.semantics));
+            attributes.insert(
+                "material".to_string(),
+                json!(relation
+                    .tags
+                    .get("building:material")
+                    .or_else(|| relation.tags.get("material"))
+                    .map(String::as_str)
+                    .unwrap_or("unspecified")),
+            );
+            let placement = building_vertical_placement(&relation.tags);
+            let mut measurements =
+                BTreeMap::from([("height_m".to_string(), measurement_lineage(height.source))]);
+            insert_building_vertical_placement(&mut attributes, &mut measurements, &placement);
+            let mut rings = vec![outer];
+            rings.extend(holes);
+            Some(CmoFeature {
+                feature_id: format!(
+                    "{}:relation:{}:building:part:{index:04}",
+                    source_provider(&relation.tags),
+                    relation.id
+                ),
+                geometry: FeatureGeometry {
+                    r#type: "Polygon".to_string(),
+                    coordinates: json!(rings),
+                },
+                attributes,
+                provenance: base_provenance("relation", relation.id, &relation.tags),
+                lineage: feature_lineage(measurements),
+            })
+        })
+        .collect()
+}
+
+fn hydrology_features_from_relation(
+    relation: &ProcessedRelation,
+    geometry: &MetricGeometryIndex,
+) -> Vec<CmoFeature> {
+    let Some(kind) = water_kind(&relation.tags) else {
+        return Vec::new();
+    };
+    assembled_relation_polygons(relation, false, geometry)
+        .into_iter()
+        .enumerate()
+        .map(|(index, (outer, holes))| {
+            let mut rings = vec![outer];
+            rings.extend(holes);
+            let mut attributes = BTreeMap::new();
+            attributes.insert("state".to_string(), json!("static_source_geometry"));
+            attributes.insert("water_kind".to_string(), json!(kind));
+            attributes.insert("geometry_role".to_string(), json!("area"));
+            let mut measurements = BTreeMap::new();
+            insert_hydrology_vertical_placement(&mut attributes, &mut measurements);
+            CmoFeature {
+                feature_id: format!(
+                    "{}:relation:{}:hydrology:part:{index:04}",
+                    source_provider(&relation.tags),
+                    relation.id
+                ),
+                geometry: FeatureGeometry {
+                    r#type: "Polygon".to_string(),
+                    coordinates: json!(rings),
+                },
+                attributes,
+                provenance: base_provenance("relation", relation.id, &relation.tags),
+                lineage: feature_lineage(measurements),
+            }
+        })
+        .collect()
+}
+
+fn extract_features(
+    elements: &[ProcessedElement],
+    suppression: &OutlineSuppression,
+    geometry: &MetricGeometryIndex,
+) -> (Vec<CmoFeature>, Vec<CmoFeature>, Vec<CmoFeature>) {
+    let mut roads = Vec::new();
+    let mut buildings = Vec::new();
+    let mut hydrology = Vec::new();
+    let mut relation_building_member_ids = HashSet::new();
+    let mut relation_hydrology_member_ids = HashSet::new();
+
+    for element in elements {
+        let ProcessedElement::Relation(relation) = element else {
+            continue;
+        };
+        if !suppression.contains(&("relation", relation.id)) {
+            let relation_features = building_features_from_relation(relation, geometry);
+            if !relation_features.is_empty() {
+                let mut has_way_sources = false;
+                for feature in &relation_features {
+                    if feature
+                        .provenance
+                        .get("source_feature_type")
+                        .and_then(Value::as_str)
+                        == Some("way")
+                    {
+                        if let Some(source_id) = feature
+                            .provenance
+                            .get("source_feature_id")
+                            .and_then(Value::as_str)
+                            .and_then(|value| value.parse::<u64>().ok())
+                        {
+                            relation_building_member_ids.insert(source_id);
+                            has_way_sources = true;
+                        }
+                    }
+                }
+                if !has_way_sources {
+                    relation_building_member_ids
+                        .extend(relation.members.iter().map(|member| member.way.id));
+                }
+                buildings.extend(relation_features);
+            }
+        }
+        let relation_features = hydrology_features_from_relation(relation, geometry);
+        if !relation_features.is_empty() {
+            relation_hydrology_member_ids
+                .extend(relation.members.iter().map(|member| member.way.id));
+            hydrology.extend(relation_features);
+        }
+    }
+
+    for element in elements {
+        match element {
+            ProcessedElement::Way(way) => {
+                roads.extend(road_features(way, geometry));
+                if !suppression.contains(&("way", way.id))
+                    && !relation_building_member_ids.contains(&way.id)
+                {
+                    if let Some(feature) = building_feature_from_way(way, None, None, geometry) {
+                        buildings.push(feature);
+                    }
+                }
+                if !relation_hydrology_member_ids.contains(&way.id) {
+                    hydrology.extend(hydrology_features_from_way(way, geometry));
+                }
+            }
+            ProcessedElement::Relation(_) => {}
+            ProcessedElement::Node(_) => {}
+        }
+    }
+    for features in [&mut roads, &mut buildings, &mut hydrology] {
+        features.sort_by(|left, right| left.feature_id.cmp(&right.feature_id));
+        features.dedup_by(|left, right| left.feature_id == right.feature_id);
+    }
+    (roads, buildings, hydrology)
+}
+
+fn write_json<T: Serialize>(path: &Path, value: &T) -> ExportResult<()> {
+    let mut writer = BufWriter::new(File::create(path)?);
+    serde_json::to_writer_pretty(&mut writer, value)?;
+    writer.write_all(b"\n")?;
+    writer.flush()?;
+    Ok(())
+}
+
+fn sha256_file(path: &Path) -> ExportResult<(String, u64)> {
+    let mut file = File::open(path)?;
+    let mut digest = Sha256::new();
+    let mut byte_length = 0_u64;
+    let mut buffer = [0_u8; 64 * 1024];
+    loop {
+        let read = file.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        digest.update(&buffer[..read]);
+        byte_length += read as u64;
+    }
+    Ok((format!("{:x}", digest.finalize()), byte_length))
+}
+
+fn sha256_bytes(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
