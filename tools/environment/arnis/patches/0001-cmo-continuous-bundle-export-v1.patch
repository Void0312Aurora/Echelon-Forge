+
+const BUNDLE_CONTRACT_VERSION: &str = "arnis_cmo_bundle.v1";
+const FEATURE_SCHEMA: &str = "arnis_cmo_features";
+const FEATURE_SCHEMA_VERSION: u32 = 1;
