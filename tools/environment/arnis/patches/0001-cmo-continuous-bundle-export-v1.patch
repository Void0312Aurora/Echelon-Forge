+const EXPORTER_PATCH_ID: &str = "0001-cmo-continuous-bundle-export-v1";
+const ARNIS_UPSTREAM_REVISION: &str = "af521c99124b5e07ecba018ea54f2ac47b6441d5";
+const METERS_PER_BUILDING_LEVEL: f64 = 3.0;
+const METERS_PER_ROAD_LANE: f64 = 3.2;
+
