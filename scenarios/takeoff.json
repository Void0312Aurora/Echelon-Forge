{
    "scenario_name": "F-16 Takeoff Training",
    "description": "Train agent to take off and reach safe altitude when given TAKEOFF command.",
    "imports": [
        {
            "file": "examples/config/prefabs/airbase_large.json"
        }
    ],
    "environment": {
        "time_step": 0.05,
        "max_steps": 2000,
        "terrain_type": "flat"
    },
    "mission_command": {
        "command_code": 1,
        "target_heading": 0.0,
        "target_altitude": 500.0,
        "target_speed": 180.0,
        "randomization": {
            "heading_range": [
                -20.0,
                20.0
            ],
            "altitude_range": [
                300.0,
                600.0
            ],
            "speed_range": [
                140.0,
                220.0
            ]
        }
    },
    "entities": [
        {
            "name": "Blue_F16",
            "type": "Aircraft",
            "side": "Blue",
            "pos": [
                10.0,
                0.0,
                2.1
            ],
            "vel": [
                0.0,
                0.0,
                0.0
            ],
            "heading": 90.0,
            "is_agent": true
        }
    ],
    "objectives": [
        {
            "type": "conditional",
            "conditions": [
                {
                    "property": "altitude",
                    "op": ">=",
                    "value": 300.0
                },
                {
                    "property": "speed",
                    "op": ">=",
                    "value": 150.0
                }
            ],
            "reward": 2000.0
        }
    ],
    "rewards": {
        "survival": 0.1,
        "crash_penalty": -1000.0,
        "altitude_progress_weight": 0.05,
        "speed_progress_weight": 0.05,
        "gear_up_bonus": 50.0,
        "stall_penalty": -0.1,
        "stall_aoa_threshold": 15.0,
        "overload_penalty": -0.1,
        "overload_g_threshold": 6.0,
        "roll_stability_weight": -0.001,
        "heading_error_weight": -0.001,
        "altitude_error_weight": -0.0001
    }
}