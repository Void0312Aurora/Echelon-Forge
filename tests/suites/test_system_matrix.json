{
  "schema_version": 1,
  "name": "test_system_matrix",
  "status": "draft",
  "intent": "Machine-readable starter matrix for mapping maintained test surfaces to governance tiers without changing CI behavior.",
  "ci_authority": {
    "current_ci_suite": "tests/smoke/ci_smoke_suite.json",
    "runner": "tools/runners/run_pytest_suite.py",
    "note": "This matrix is advisory metadata only; CI remains bound to the smoke suite until explicitly changed elsewhere."
  },
  "tiers": {
    "smoke": {
      "meaning": "Fast, high-signal regression coverage allowed to gate CI.",
      "ci_default": true
    },
    "focused": {
      "meaning": "Small domain-oriented suites for local pre-merge checks and targeted ownership review.",
      "ci_default": false
    },
    "local": {
      "meaning": "Developer-run suites that may be broader or more environment-sensitive than focused suites.",
      "ci_default": false
    },
    "manual": {
      "meaning": "Human-invoked checks, diagnostics, or workflows that need judgment or special setup.",
      "ci_default": false
    },
    "nightly": {
      "meaning": "Candidate long-running or broad regression coverage for scheduled automation after stabilization.",
      "ci_default": false
    }
  },
