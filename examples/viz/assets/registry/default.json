        "yaw_correction_deg": 0.0,
        "waterline_offset_m": 0.5,
        "chase_offset": [0.0, 95.0, 310.0],
        "fallback_hull_length_m": 215.0,
        "fallback_hull_beam_m": 32.0,
        "fallback_hull_height_m": 16.0,
        "fallback_super_length_m": 90.0,
        "fallback_super_beam_m": 22.0,
        "fallback_super_height_m": 28.0,
        "fallback_super_offset_x_m": -35.0,
        "fallback_super_offset_y_m": 28.0
