{
  "algo": "AdaptiveKLPPO",
  "policy": "SquashedMultiInputPolicy",
  "total_timesteps": 120000,
  "n_envs": 24,
  "save_freq": 30000,
  "wrappers": {
    "multi_timescale_action": {
      "enabled": true,
      "hold_steps": 3,
      "low_freq_indices": [4, 5, 6, 9, 12, 13, 14, 15, 16],
      "snap_binary_indices": [4, 9, 12, 13, 14, 15],
      "action_rate_penalty_coef": 0.0002
    }
  },
  "curriculum": {
    "check_freq": 20000,
    "stages": [
      {
        "until_timesteps": 40000,
        "randomization": {
          "world_yaw_range": [0.0, 0.0],
          "wind_speed_range": [0.0, 6.0],
          "wind_dir_from_range": [240.0, 300.0],
          "wind_shear_range": [0.0, 3.0]
        }
      },
      {
        "until_timesteps": 90000,
        "randomization": {
          "world_yaw_range": [-30.0, 30.0],
          "wind_speed_range": [0.0, 12.0],
          "wind_dir_from_range": [180.0, 360.0],
          "wind_shear_range": [0.0, 8.0]
        }
      },
      {
        "until_timesteps": null,
        "randomization": {
          "world_yaw_range": [-60.0, 60.0],
          "wind_speed_range": [0.0, 20.0],
          "wind_dir_from_range": [0.0, 360.0],
          "wind_shear_range": [0.0, 12.0]
        }
      }
    ]
  },
  "hyperparameters": {
    "learning_rate": 2e-05,
    "n_steps": 256,
    "batch_size": 3072,
    "n_epochs": 4,
    "gamma": 0.999,
    "gae_lambda": 0.97,
    "clip_range": 0.08,
    "clip_range_vf": 0.1,
    "normalize_advantage": true,
    "ent_coef": 0.0002,
    "vf_coef": 0.7,
    "max_grad_norm": 0.5,
    "target_kl": 0.012,
    "kl_penalty_coef": 0.05,
    "kl_penalty_coef_min": 0.01,
    "kl_penalty_coef_max": 2.0,
    "kl_adaptive": true,
    "kl_adapt_factor": 1.25,
    "lr_mult_max": 1.5,
    "clip_mult_max": 1.25,
    "device": "cuda",
    "policy_kwargs": {
      "features_extractor_class": "TransformerVisualExtractor",
      "features_extractor_kwargs": {
        "features_dim": 192,
        "n_heads": 4,
        "n_layers": 3,
        "visual_cnn_channels": 32,
        "use_amp": true,
        "use_checkpointing": true
      },
      "log_std_init": -1.5,
      "net_arch": {
        "pi": [192, 192],
        "vf": [192, 192]
      }
    }
  }
}
