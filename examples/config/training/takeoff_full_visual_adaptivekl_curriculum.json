{
    "algo": "AdaptiveKLPPO",
    "policy": "SquashedMultiInputPolicy",
    "total_timesteps": 10000000,
    "n_envs": 64,
    "save_freq": 100000,
    "wrappers": {
        "multi_timescale_action": {
            "enabled": true,
            "hold_steps": 4,
            "low_freq_indices": [
                4,
                5,
                6,
                9,
                12,
                13,
                14,
                15,
                16
            ],
            "snap_binary_indices": [
                4,
                9,
                12,
                13,
                14,
                15
            ],
            "action_rate_penalty_coef": 0.0005
        }
    },
    "curriculum": {
        "check_freq": 25000,
        "stages": [
            {
                "until_timesteps": 300000,
                "randomization": {
                    "world_yaw_range": [
                        0.0,
                        0.0
                    ],
                    "wind_speed_range": [
                        0.0,
                        0.0
                    ]
                }
            },
            {
                "until_timesteps": 1000000,
                "randomization": {
                    "world_yaw_range": [
                        -10.0,
                        10.0
                    ],
                    "wind_speed_range": [
                        0.0,
                        3.0
                    ],
                    "wind_dir_from_range": [
                        240.0,
                        300.0
                    ]
                }
            },
            {
                "until_timesteps": null,
                "randomization": {
                    "world_yaw_range": [
                        -25.0,
                        25.0
                    ],
                    "wind_speed_range": [
                        0.0,
                        6.0
                    ],
                    "wind_dir_from_range": [
                        180.0,
                        360.0
                    ]
                }
            }
        ]
    },
    "hyperparameters": {
        "learning_rate": 5e-05,
        "n_steps": 128,
        "batch_size": 4096,
        "n_epochs": 5,
        "gamma": 0.999,
        "gae_lambda": 0.97,
        "clip_range": 0.1,
        "clip_range_vf": 0.1,
        "normalize_advantage": true,
        "ent_coef": 0.0005,
        "vf_coef": 0.5,
        "max_grad_norm": 0.5,
        "target_kl": 0.02,
        "kl_penalty_coef": 0.0,
        "kl_adaptive": true,
        "policy_kwargs": {
            "features_extractor_class": "TransformerVisualExtractor",
            "features_extractor_kwargs": {
                "features_dim": 256,
                "n_heads": 4,
                "n_layers": 4,
                "visual_cnn_channels": 64,
                "use_amp": false,
                "use_checkpointing": true
            },
            "log_std_init": -1.5,
            "net_arch": {
                "pi": [
                    256,
                    256
                ],
                "vf": [
                    256,
                    256
                ]
            }
        }
    }
}
