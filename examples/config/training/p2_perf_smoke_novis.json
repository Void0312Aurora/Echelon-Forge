{
  "algo": "AdaptiveKLPPO",
  "policy": "SquashedMultiInputPolicy",
  "total_timesteps": 4096,
  "n_envs": 4,
  "save_freq": 100000,
  "hyperparameters": {
    "learning_rate": 2.5e-05,
    "n_steps": 128,
    "batch_size": 512,
    "n_epochs": 2,
    "gamma": 0.999,
    "gae_lambda": 0.97,
    "clip_range": 0.1,
    "clip_range_vf": 0.1,
    "normalize_advantage": true,
    "ent_coef": 0.0002,
    "vf_coef": 0.7,
    "max_grad_norm": 0.5,
    "target_kl": 0.02,
    "kl_penalty_coef": 0.0,
    "kl_adaptive": true,
    "device": "cuda",
    "policy_kwargs": {
      "features_extractor_class": "TransformerExtractor",
      "features_extractor_kwargs": {
        "features_dim": 128,
        "n_heads": 4,
        "n_layers": 2,
        "use_amp": true,
        "use_checkpointing": true
      },
      "log_std_init": -1.5,
      "net_arch": {
        "pi": [128, 128],
        "vf": [128, 128]
      }
    }
  }
}
