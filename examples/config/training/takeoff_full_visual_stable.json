{
    "algo": "PPO",
    "policy": "MultiInputPolicy",
    "total_timesteps": 10000000,
    "n_envs": 64,
    "save_freq": 100000,
    "hyperparameters": {
        "learning_rate": 5e-05,
        "n_steps": 128,
        "batch_size": 4096,
        "n_epochs": 5,
        "gamma": 0.999,
        "gae_lambda": 0.97,
        "clip_range": 0.1,
        "clip_range_vf": 0.1,
        "normalize_advantage": true,
        "ent_coef": 0.0005,
        "vf_coef": 0.5,
        "max_grad_norm": 0.5,
        "target_kl": 0.02,
        "policy_kwargs": {
            "features_extractor_class": "TransformerVisualExtractor",
            "features_extractor_kwargs": {
                "features_dim": 256,
                "n_heads": 4,
                "n_layers": 4,
                "visual_cnn_channels": 64,
                "use_amp": false,
                "use_checkpointing": true
            },
            "log_std_init": -1.5,
            "net_arch": {
                "pi": [
                    256,
                    256
                ],
                "vf": [
                    256,
                    256
                ]
            }
        }
    }
}
