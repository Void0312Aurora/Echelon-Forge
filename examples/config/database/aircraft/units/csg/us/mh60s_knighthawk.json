            "airframe.drag_coefficient": {"value_basis": "proxy", "source_ids": [], "tier": "proxy", "note": "copied unchanged from CSG_US_MH-60R_Seahawk; no public figure, and the S-model's external shape (aside from cabin doors) is aerodynamically similar"},
            "airframe.reference_area": {"value_basis": "proxy", "source_ids": [], "tier": "proxy", "note": "copied unchanged from CSG_US_MH-60R_Seahawk; both variants share the same S-70B main rotor system per Wikipedia (rotor diameter/disc area not separately published for the S-model, but stated to be shared hardware)"},
            "airframe.length_m": {"value_basis": "sourced", "source_ids": ["csg-us-mh60s-navair"], "tier": "A", "note": "64 ft 10 in = 19.76 m per NAVAIR, identical to the MH-60R figure (shared external length)"},
            "airframe.wingspan_m": {"value_basis": "proxy", "source_ids": ["csg-us-mh60-wiki"], "tier": "proxy", "note": "rotor-diameter-as-wingspan copied unchanged from CSG_US_MH-60R_Seahawk per Wikipedia's statement that the MH-60S shares 'the folding tail pylon, engines, drivetrain and rotors of the S-70B/SH-60' (i.e. the same main rotor system as the MH-60R), no S-model-specific rotor diameter separately published"},
