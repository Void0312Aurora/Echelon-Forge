        "designation": "CMV-22B Osprey",
        "role": "Carrier Onboard Delivery (COD) — unarmed tiltrotor logistics transport replacing the C-2A, delivering personnel/mail/high-priority cargo (including F-35C engine power modules) between shore bases and CVN-78; combines vertical takeoff/landing with turboprop-speed cruise per NAVAIR",
        "crew": "4 (pilot, copilot, two crew chiefs)",
        "status": "content_only_full_damage_model",
        "carrier_features": "vertical takeoff/landing capability eliminates catapult/arresting-gear dependency (no tailhook modeled); wing-mounted tiltrotor nacelles rotate 90 degrees between helicopter and airplane mode per Boeing; folds for shipboard hangar stowage (rotors fold, wing rotates to align with fuselage per Wikipedia) though not separately modeled as a hitbox component given the packet's damage-model scope"
    },
    "_provenance": {
        "sources": ["csg-us-cmv22b-navair", "csg-us-v22-boeing", "csg-us-v22-wiki", "csg-us-mv22b-navair"],
        "parameters": {
            "airframe.empty_mass_kg": {"value_basis": "engineering_estimate", "source_ids": ["csg-us-cmv22b-navair"], "tier": "proxy", "note": "no CMV-22B-specific empty-weight figure published by NAVAIR (only max-gross-weight variants given); derived as an engineering_estimate from the MV-22B's commonly-cited ~33,140 lb (15,032 kg) empty weight (same Bell-Boeing airframe/engine per NAVAIR, CMV-22B differs mainly in avionics/radio/lighting per NAVAIR's own CMV-22B-vs-MV-22B comparison, not structural mass)"},
            "airframe.max_fuel_kg": {"value_basis": "engineering_estimate", "source_ids": [], "tier": "proxy", "note": "no public figure; engineering estimate for the V-22's internal fuel capacity based on its sourced 1,150 nmi CMV-22B range and turboshaft fuel-burn class, consistent with the packet's existing turboprop/turboshaft engineering-estimate approach for T56/AE1107C-family aircraft"},
            "airframe.drag_coefficient": {"value_basis": "engineering_estimate", "source_ids": [], "tier": "proxy", "note": "no public figure; engineering estimate reflecting the V-22's high-disk-loading tiltrotor/wing/nacelle configuration, higher than a clean fixed-wing turboprop"},
            "airframe.reference_area": {"value_basis": "engineering_estimate", "source_ids": ["csg-us-v22-boeing"], "tier": "proxy", "note": "105.7 m2 engineering estimate combining both proprotor disc areas (Boeing: rotor diameter 38.1 ft/11.6 m each, 2x pi*(5.8)^2 = ~211 m2 total swept disc, halved as a rough net-lift-relevant reference-area proxy since the two rotor discs substantially overlap the wing's own planform) — flagged as one of the least-certain proxies in this record given the V-22's unconventional dual-rotor-plus-wing lift configuration with no single 'reference area' concept analogous to a fixed-wing aircraft"},
            "airframe.length_m": {"value_basis": "sourced", "source_ids": ["csg-us-v22-boeing"], "tier": "A", "note": "fuselage length 57.3 ft = 17.47 m per Boeing's official V-22 product page, cross-confirmed by NAVAIR's CMV-22B page's identical 57'4in figure"},
            "airframe.wingspan_m": {"value_basis": "sourced", "source_ids": ["csg-us-v22-boeing"], "tier": "A", "note": "rotor diameter 38.1 ft = 11.6 m per Boeing, mapped to airframe.wingspan_m per this packet's established helicopter/rotor-diameter-as-wingspan convention (same basis as MH-60R/S); NAVAIR's stated 83'10in/25.56m figure is the rotors-turning tip-to-tip width (both proprotor discs plus wing), not a single-rotor diameter, so Boeing's explicit per-rotor diameter figure was used instead for consistency with the repo's per-rotor convention"},
            "airframe.height_m": {"value_basis": "sourced", "source_ids": ["csg-us-cmv22b-navair"], "tier": "A", "note": "22 ft 1 in = 6.73 m per NAVAIR's direct CMV-22B product page (nacelles-vertical configuration), cross-confirmed by Boeing's identical 22.1 ft figure"},
