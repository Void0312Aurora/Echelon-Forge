{
  "algo": "AdaptiveKLPPO",
  "policy": "SquashedMultiInputPolicy",
  "total_timesteps": 80000,
  "n_envs": 32,
  "save_freq": 20000,
  "env": {
    "include_proprio": true,
    "mission_obs_mode": "basic",
    "visual_downsample": 2,
    "visual_update_interval": 2,
    "action_mode": "full"
  },
  "early_stop": {
    "enabled": true,
    "min_timesteps": 40000,
    "check_every_timesteps": 20000,
    "patience_checks": 3,
    "min_improvement": 10.0,
    "ema_alpha": 0.08
  },
  "wrappers": {
    "multi_timescale_action": {
      "enabled": true,
      "hold_steps": 4,
      "low_freq_indices": [4, 5, 6, 9, 12, 13, 14, 15, 16],
      "snap_binary_indices": [4, 9, 12, 13, 14, 15],
      "binary_hysteresis_indices": [4, 9, 12, 13, 14, 15],
      "binary_on_threshold": 0.75,
      "binary_off_threshold": 0.25,
      "binary_initial_values": {
        "4": 1.0,
        "9": 0.0,
        "12": 0.0,
        "13": 0.0,
        "14": 0.0,
        "15": 0.0
      },
      "center_deadband_indices": [5, 6, 7, 8],
      "center_deadband_center": 0.5,
      "center_deadband_half_width": 0.18,
      "scripted_baseline_mode": "takeoff",
      "scripted_residual_scale": 0.2,
      "scripted_residual_alt_breakpoints_m": [0.0, 8.0, 35.0, 120.0],
      "scripted_residual_alt_scales": [0.2, 0.2, 0.32, 0.5],
      "scripted_blend_indices": [0, 1, 2],
      "scripted_lock_indices": [3, 4, 5, 6, 7, 8],
      "action_rate_penalty_coef": 0.0002
    }
  },
  "curriculum": {
    "check_freq": 20000,
    "stages": [
      {
        "until_timesteps": 30000,
        "randomization": {
          "world_yaw_range": [0.0, 0.0],
          "rotate_mission_heading_with_world": true,
          "wind_headwind_range": [0.0, 6.0],
          "wind_crosswind_range": [-3.0, 3.0],
          "wind_tailwind_max_mps": 1.0,
          "wind_shear_range": [0.0, 2.0]
        }
      },
      {
        "until_timesteps": 60000,
        "randomization": {
          "world_yaw_range": [0.0, 180.0],
          "rotate_mission_heading_with_world": true,
          "wind_headwind_range": [0.0, 12.0],
          "wind_crosswind_range": [-6.0, 6.0],
          "wind_tailwind_max_mps": 3.0,
          "wind_shear_range": [0.0, 6.0]
        }
      },
      {
        "until_timesteps": null,
        "randomization": {
          "world_yaw_range": [0.0, 360.0],
          "rotate_mission_heading_with_world": true,
          "wind_headwind_range": [0.0, 20.0],
          "wind_crosswind_range": [-12.0, 12.0],
          "wind_tailwind_max_mps": 5.0,
          "wind_shear_range": [0.0, 10.0]
        }
      }
    ]
  },
  "hyperparameters": {
    "learning_rate": 2e-05,
    "n_steps": 128,
    "batch_size": 4096,
    "n_epochs": 4,
    "gamma": 0.999,
    "gae_lambda": 0.97,
    "clip_range": 0.1,
    "clip_range_vf": 0.1,
    "normalize_advantage": true,
    "ent_coef": 0.00015,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "target_kl": 0.02,
    "kl_penalty_coef": 0.0,
    "kl_adaptive": true,
    "device": "cuda",
    "policy_kwargs": {
      "features_extractor_class": "TransformerVisualExtractor",
      "features_extractor_kwargs": {
        "features_dim": 256,
        "n_heads": 4,
        "n_layers": 4,
        "visual_cnn_channels": 64,
        "use_amp": true,
        "use_checkpointing": true
      },
      "log_std_init": -1.5,
      "net_arch": {
        "pi": [256, 256],
        "vf": [256, 256]
      }
    }
  }
}
