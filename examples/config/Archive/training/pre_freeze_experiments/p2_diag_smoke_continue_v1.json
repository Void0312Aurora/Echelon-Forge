{
  "algo": "AdaptiveKLPPO",
  "policy": "SquashedMultiInputPolicy",
  "total_timesteps": 8192,
  "n_envs": 2,
  "save_freq": 4096,
  "hyperparameters": {
    "learning_rate": 3e-05,
    "n_steps": 128,
    "batch_size": 256,
    "n_epochs": 3,
    "gamma": 0.999,
    "gae_lambda": 0.97,
    "clip_range": 0.1,
    "clip_range_vf": 0.1,
    "normalize_advantage": true,
    "ent_coef": 0.0003,
    "vf_coef": 0.7,
    "max_grad_norm": 0.5,
    "target_kl": 0.015,
    "kl_penalty_coef": 0.02,
    "kl_adaptive": true,
    "kl_adapt_factor": 1.25,
    "low_kl_boost_patience": 3,
    "boost_lr_on_low_kl": true,
    "boost_clip_on_low_kl": false,
    "device": "cuda",
    "policy_kwargs": {
      "features_extractor_class": "TransformerVisualExtractor",
      "features_extractor_kwargs": {
        "features_dim": 256,
        "n_heads": 4,
        "n_layers": 2,
        "visual_cnn_channels": 48,
        "use_amp": true,
        "use_checkpointing": true
      },
      "log_std_init": -1.5,
      "net_arch": {
        "pi": [
          256,
          256
        ],
        "vf": [
          256,
          256
        ]
      }
    }
  }
}
