{
  "$id": "https://echelon-forge.local/contracts/ledger/run_receipt.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonicalization", "domain", "envelope_version", "media_type", "payload", "payload_sha256", "signatures"],
  "properties": {
    "canonicalization": {"const": "echelon_forge.canonical_json.v2"},
    "domain": {"const": "runtime.run-receipt"},
    "envelope_version": {"const": "echelon_forge.authority_envelope.v1"},
    "media_type": {"const": "application/vnd.echelon-forge.run-receipt.v1+json"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_kind", "schema_version", "contract_version", "writer_role", "receipt_id", "run_id", "attempt_id", "host_boot_id", "incarnation_epoch", "writer_generation", "reader_generation_min", "reader_generation_max", "admission_binding_sha256", "plan_binding", "release_binding", "executable", "package", "build", "platform", "inputs", "backend", "execution_scope", "lifecycle", "results", "checkpoints", "qualification_refs", "side_effect_receipts", "completion", "terminal_state", "terminal_reason", "journal_id", "journal_last_sequence", "journal_last_record_sha256", "retention_class", "hash_algorithm", "authenticity"],
      "allOf": [{"if": {"properties": {"terminal_state": {"const": "completed"}}}, "then": {"properties": {"results": {"properties": {"output_artifacts": {"minItems": 1}}}}}}],
      "properties": {
        "authority_kind": {"const": "run_receipt"}, "schema_version": {"const": "echelon_forge.run_receipt.v1"}, "contract_version": {"const": "echelon_forge.run_receipt_contract.v1"}, "writer_role": {"const": "runtime_host"}, "hash_algorithm": {"const": "sha256"},
        "receipt_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "host_boot_id": {"type": "string", "minLength": 1}, "journal_id": {"type": "string", "minLength": 1},
        "incarnation_epoch": {"$ref": "#/$defs/generation"}, "writer_generation": {"$ref": "#/$defs/generation"}, "reader_generation_min": {"$ref": "#/$defs/generation"}, "reader_generation_max": {"$ref": "#/$defs/generation"}, "admission_binding_sha256": {"$ref": "#/$defs/sha256"}, "journal_last_sequence": {"$ref": "#/$defs/safe_integer"}, "journal_last_record_sha256": {"$ref": "#/$defs/sha256"}, "terminal_state": {"enum": ["completed", "failed", "cancelled", "rejected", "crashed", "incomplete"]}, "terminal_reason": {"type": "string", "minLength": 1}, "retention_class": {"enum": ["active-release", "rollback-window", "run-retained", "evidence-short"]},
        "plan_binding": {"$ref": "#/$defs/plan_binding"}, "release_binding": {"$ref": "#/$defs/release_binding"}, "executable": {"$ref": "#/$defs/executable"}, "package": {"$ref": "#/$defs/package"}, "build": {"$ref": "#/$defs/build"}, "platform": {"$ref": "#/$defs/platform"}, "inputs": {"$ref": "#/$defs/inputs"}, "backend": {"$ref": "#/$defs/backend"}, "execution_scope": {"$ref": "#/$defs/execution_scope"}, "lifecycle": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lifecycle_event"}}, "results": {"$ref": "#/$defs/results"}, "checkpoints": {"$ref": "#/$defs/checkpoints"}, "qualification_refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}}, "side_effect_receipts": {"type": "array", "items": {"$ref": "#/$defs/side_effect"}}, "completion": {"$ref": "#/$defs/completion"}, "authenticity": {"$ref": "#/$defs/authenticity"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "generation": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"}, "safe_integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "text": {"type": "string", "minLength": 1}, "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"}, "digest_map": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "plan_binding": {"type": "object", "additionalProperties": false, "required": ["plan_id", "plan_sha256", "request_sha256", "plan_generation", "plan_canonical_sha256", "plan_location", "request_canonical_sha256", "request_location", "compiler_identity", "compiler_version"], "properties": {"plan_id": {"$ref": "#/$defs/id"}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "plan_generation": {"$ref": "#/$defs/generation"}, "plan_canonical_sha256": {"$ref": "#/$defs/sha256"}, "plan_location": {"$ref": "#/$defs/text"}, "request_canonical_sha256": {"$ref": "#/$defs/sha256"}, "request_location": {"$ref": "#/$defs/text"}, "compiler_identity": {"$ref": "#/$defs/text"}, "compiler_version": {"$ref": "#/$defs/text"}}},
    "release_binding": {"type": "object", "additionalProperties": false, "required": ["release_id", "release_manifest_sha256", "rollout_decision_id", "rollout_decision_sha256", "provenance_sha256", "sbom_sha256", "attestation_sha256"], "properties": {"release_id": {"$ref": "#/$defs/id"}, "release_manifest_sha256": {"$ref": "#/$defs/sha256"}, "rollout_decision_id": {"$ref": "#/$defs/id"}, "rollout_decision_sha256": {"$ref": "#/$defs/sha256"}, "provenance_sha256": {"$ref": "#/$defs/sha256"}, "sbom_sha256": {"$ref": "#/$defs/sha256"}, "attestation_sha256": {"$ref": "#/$defs/sha256"}}},
    "executable": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "digest", "native_module_digests", "plugin_digests"], "properties": {"identity": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/sha256"}, "native_module_digests": {"$ref": "#/$defs/digest_map"}, "plugin_digests": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}}},
    "package": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "digest", "wheel_digest", "dependency_graph_sha256"], "properties": {"identity": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/sha256"}, "wheel_digest": {"$ref": "#/$defs/sha256"}, "dependency_graph_sha256": {"$ref": "#/$defs/sha256"}}},
    "build": {"type": "object", "additionalProperties": false, "required": ["source_revision", "dirty", "build_mode", "linker", "toolchain", "cxx_abi", "python_abi", "node_abi"], "properties": {"source_revision": {"$ref": "#/$defs/text"}, "dirty": {"type": "boolean"}, "build_mode": {"$ref": "#/$defs/text"}, "linker": {"$ref": "#/$defs/text"}, "toolchain": {"$ref": "#/$defs/text"}, "cxx_abi": {"$ref": "#/$defs/text"}, "python_abi": {"$ref": "#/$defs/text"}, "node_abi": {"$ref": "#/$defs/text"}}},
    "platform": {"type": "object", "additionalProperties": false, "required": ["os", "architecture", "compiler", "standard_library", "cpu", "gpu", "driver", "runtime_dependency_digests"], "properties": {"os": {"$ref": "#/$defs/text"}, "architecture": {"$ref": "#/$defs/text"}, "compiler": {"$ref": "#/$defs/text"}, "standard_library": {"$ref": "#/$defs/text"}, "cpu": {"$ref": "#/$defs/text"}, "gpu": {"$ref": "#/$defs/text"}, "driver": {"$ref": "#/$defs/text"}, "runtime_dependency_digests": {"$ref": "#/$defs/digest_map"}}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "content_id", "database_id", "configuration_id", "seed_policy", "seed_value", "seed_stream_id", "artifacts"], "properties": {"scenario_id": {"$ref": "#/$defs/text"}, "content_id": {"$ref": "#/$defs/text"}, "database_id": {"$ref": "#/$defs/text"}, "configuration_id": {"$ref": "#/$defs/text"}, "seed_policy": {"$ref": "#/$defs/text"}, "seed_value": {"$ref": "#/$defs/text"}, "seed_stream_id": {"$ref": "#/$defs/text"}, "artifacts": {"$ref": "#/$defs/digest_map"}}},
    "backend": {"type": "object", "additionalProperties": false, "required": ["profile_id", "backend_provider_id", "backend_implementation_version", "determinism_profile", "system_graph_sha256", "stage_contract_sha256"], "properties": {"profile_id": {"$ref": "#/$defs/text"}, "backend_provider_id": {"$ref": "#/$defs/text"}, "backend_implementation_version": {"$ref": "#/$defs/text"}, "determinism_profile": {"$ref": "#/$defs/text"}, "system_graph_sha256": {"$ref": "#/$defs/sha256"}, "stage_contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "execution_scope": {"type": "object", "additionalProperties": false, "required": ["world_ids", "entity_ids", "episode_ids", "request_ids", "epochs"], "properties": {"world_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "entity_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "episode_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "request_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "epochs": {"type": "object", "additionalProperties": false, "required": ["world", "entity", "episode", "request"], "properties": {"world": {"$ref": "#/$defs/generation"}, "entity": {"$ref": "#/$defs/generation"}, "episode": {"$ref": "#/$defs/generation"}, "request": {"$ref": "#/$defs/generation"}}}}},
    "lifecycle_event": {"type": "object", "additionalProperties": false, "required": ["sequence", "event", "timestamp", "epoch", "durable_sequence"], "properties": {"sequence": {"$ref": "#/$defs/safe_integer"}, "event": {"enum": ["journal_admitted", "construction", "validation", "publication", "episode", "drain", "rollback", "shutdown", "reclamation", "terminal"]}, "timestamp": {"$ref": "#/$defs/text"}, "epoch": {"$ref": "#/$defs/generation"}, "durable_sequence": {"$ref": "#/$defs/safe_integer"}}},
    "results": {"type": "object", "additionalProperties": false, "required": ["result_digest", "output_artifacts", "native_validation"], "properties": {"result_digest": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/sha256"}]}, "output_artifacts": {"type": "array", "items": {"$ref": "#/$defs/output_artifact"}}, "native_validation": {"type": "object", "additionalProperties": false, "required": ["accepted", "validator_id", "evidence_sha256"], "properties": {"accepted": {"type": "boolean"}, "validator_id": {"$ref": "#/$defs/id"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}}}}},
    "checkpoint_ref": {"type": "object", "additionalProperties": false, "required": ["checkpoint_id", "checkpoint_sha256", "validation_sha256", "state_schema_generation", "retrieval_location"], "properties": {"checkpoint_id": {"$ref": "#/$defs/id"}, "checkpoint_sha256": {"$ref": "#/$defs/sha256"}, "validation_sha256": {"$ref": "#/$defs/sha256"}, "state_schema_generation": {"$ref": "#/$defs/generation"}, "retrieval_location": {"$ref": "#/$defs/text"}}},
    "checkpoints": {"type": "object", "additionalProperties": false, "required": ["source_refs", "created_refs"], "properties": {"source_refs": {"type": "array", "items": {"$ref": "#/$defs/checkpoint_ref"}}, "created_refs": {"type": "array", "items": {"$ref": "#/$defs/checkpoint_ref"}}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["identity", "digest"], "properties": {"identity": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/sha256"}}},
    "side_effect": {"type": "object", "additionalProperties": false, "required": ["identity", "digest", "media_type", "retrieval_location"], "properties": {"identity": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/sha256"}, "media_type": {"$ref": "#/$defs/text"}, "retrieval_location": {"$ref": "#/$defs/text"}}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["created_at", "finalized_at", "durable_ack"], "properties": {"created_at": {"$ref": "#/$defs/text"}, "finalized_at": {"$ref": "#/$defs/text"}, "durable_ack": {"const": true}}},
    "output_artifact": {"type": "object", "additionalProperties": false, "required": ["name", "digest", "media_type", "size", "availability", "retention_class", "retrieval_location"], "properties": {"name": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/sha256"}, "media_type": {"$ref": "#/$defs/text"}, "size": {"$ref": "#/$defs/safe_integer"}, "availability": {"$ref": "#/$defs/text"}, "retention_class": {"enum": ["active-release", "rollback-window", "run-retained", "evidence-short"]}, "retrieval_location": {"$ref": "#/$defs/text"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "signature", "signer_context"], "properties": {"algorithm": {"$ref": "#/$defs/text"}, "key_id": {"$ref": "#/$defs/text"}, "signature": {"$ref": "#/$defs/text"}, "signer_context": {"$ref": "#/$defs/text"}}},
    "authenticity": {"type": "object", "additionalProperties": false, "required": ["attestation_sha256", "signatures"], "properties": {"attestation_sha256": {"$ref": "#/$defs/sha256"}, "signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}}}}
  }
}
