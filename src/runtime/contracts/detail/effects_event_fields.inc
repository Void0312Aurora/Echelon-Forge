// Private X-macro fragment: single owner of the EffectsEvent field surface.
// Consumers must define both macros before including this file and #undef
// them afterwards:
//   EF_EFFECTS_EVENT_FIELD(type, name, default_value)
//     field owned by EffectsEvent only.
//   EF_EFFECTS_EVENT_RESULT_FIELD(type, name, default_value)
//     field that also exists on EffectsResult under the same member name and
//     is projected by engagement_events::apply_effects_result_fields.
// Field order is the authoritative EffectsEvent declaration order; designated
// initializers and the Python binding surface depend on it, so do not reorder.
// Intentionally no include guard: the list is re-expanded under different
// macro definitions (contract struct, result projection, Python bindings).

#if !defined(EF_EFFECTS_EVENT_FIELD) || !defined(EF_EFFECTS_EVENT_RESULT_FIELD)
#error "define EF_EFFECTS_EVENT_FIELD and EF_EFFECTS_EVENT_RESULT_FIELD before including effects_event_fields.inc"
#endif

