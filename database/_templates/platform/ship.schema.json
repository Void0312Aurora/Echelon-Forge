{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:echelon-forge:equipment-template:ship:v1",
  "title": "Echelon Forge ship Template",
  "description": "Ship template.",
  "type": "object",
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Inline hint."
    },
    "name": {
      "type": "string",
      "description": "Stable lookup name."
    },
    "type": {
      "type": "string",
      "const": "Ship",
      "description": "Unit discriminator."
    },
    "ship_platform": {
      "type": "object",
      "properties": {
        "displacement_light_kg": {
          "type": "number",
          "description": "Light displacement."
        },
        "displacement_full_load_kg": {
          "type": "number",
          "description": "Full-load displacement."
        },
        "length_m": {
          "type": "number",
          "description": "Length."
        },
        "beam_m": {
          "type": "number",
          "description": "Beam."
        },
        "draft_m": {
          "type": "number",
          "description": "Draft."
        },
        "height_above_waterline_m": {
          "type": "number",
          "description": "Height above waterline."
        },
        "max_speed_mps": {
          "type": "number",
          "description": "Maximum speed."
        },
        "economical_speed_mps": {
          "type": "number",
          "description": "Economical speed."
        },
        "range_nm": {
          "type": "number",
          "description": "Range."
        },
        "range_speed_mps": {
          "type": "number",
          "description": "Range speed."
        },
        "max_accel_mps2": {
          "type": "number",
          "description": "Maximum acceleration."
        },
        "max_decel_mps2": {
          "type": "number",
          "description": "Maximum deceleration."
        },
        "max_turn_rate_deg_s": {
          "type": "number",
          "description": "Maximum turn rate."
        },
        "low_speed_turn_factor": {
          "type": "number",
          "description": "Low-speed turn factor."
        },
        "steerageway_speed_mps": {
          "type": "number",
          "description": "Steerageway speed."
        },
        "sea_state": {
          "type": "number",
          "description": "Sea state."
        },
        "wave_heading_deg": {
          "type": "number",
          "description": "Wave heading."
        },
        "wave_period_s": {
          "type": "number",
          "description": "Wave period."
        },
        "max_roll_deg_sea_state_6": {
          "type": "number",
          "description": "Roll at sea state 6."
        },
        "max_pitch_deg_sea_state_6": {
          "type": "number",
          "description": "Pitch at sea state 6."
        },
        "added_resistance_fraction_sea_state_6": {
          "type": "number",
          "description": "Added resistance at sea state 6."
        },
        "crew": {
          "type": "integer",
          "description": "Crew count."
        }
      },
      "required": [
        "displacement_light_kg",
        "displacement_full_load_kg",
        "length_m",
        "beam_m",
        "draft_m",
        "height_above_waterline_m",
        "max_speed_mps",
        "economical_speed_mps",
        "range_nm",
        "range_speed_mps",
        "max_accel_mps2",
        "max_decel_mps2",
        "max_turn_rate_deg_s",
        "low_speed_turn_factor",
        "steerageway_speed_mps",
        "sea_state",
        "wave_heading_deg",
        "wave_period_s",
        "max_roll_deg_sea_state_6",
        "max_pitch_deg_sea_state_6",
        "added_resistance_fraction_sea_state_6",
        "crew"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "description": "Ship platform inputs."
    },
    "health": {
      "$ref": "urn:echelon-forge:equipment-common:v1#/$defs/Health",
      "description": "Health."
    },
    "sensor_ref": {
      "$ref": "urn:echelon-forge:equipment-common:v1#/$defs/DefinitionRef",
      "description": "Sensor reference."
    },
    "sensor_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:echelon-forge:equipment-common:v1#/$defs/DefinitionRef",
        "description": "Sensor reference."
      },
      "description": "Sensor references."
    },
    "esm": {
      "type": "object",
      "properties": {
        "sensitivity_dbm": {
          "type": "number",
          "description": "ESM sensitivity."
        },
        "max_detection_range_m": {
          "type": "number",
          "description": "Detection range."
        },
        "classify_emitters": {
          "type": "boolean",
          "description": "Classification flag."
        }
      },
      "required": [
        "sensitivity_dbm",
        "max_detection_range_m",
        "classify_emitters"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "description": "ESM inputs."
    },
    "has_command_link": {
      "type": "boolean",
      "description": "Command-link flag."
    },
    "command_link": {
      "$ref": "urn:echelon-forge:equipment-common:v1#/$defs/CommandLink",
      "description": "Command-link behavior."
    },
    "has_data_link": {
      "type": "boolean",
      "description": "Data-link flag."
    },
    "data_link_network_id": {
      "type": "integer",
      "description": "Network identifier."
    },
    "naval_stores": {
      "type": "object",
      "properties": {
        "fuel_units_current": {
          "type": "number",
          "description": "Current fuel units."
        },
        "fuel_units_max": {
          "type": "number",
          "description": "Maximum fuel units."
        },
        "missile_units_current": {
          "type": "number",
          "description": "Current missile units."
        },
        "missile_units_max": {
          "type": "number",
          "description": "Maximum missile units."
        },
        "dry_cargo_units_current": {
          "type": "number",
          "description": "Current dry-cargo units."
        },
        "dry_cargo_units_max": {
          "type": "number",
          "description": "Maximum dry-cargo units."
        },
        "can_receive_underway": {
          "type": "boolean",
          "description": "Receive-underway flag."
        },
        "can_provide_underway": {
          "type": "boolean",
          "description": "Provide-underway flag."
        }
      },
      "required": [
        "fuel_units_current",
        "fuel_units_max",
        "missile_units_current",
        "missile_units_max",
        "dry_cargo_units_current",
        "dry_cargo_units_max",
        "can_receive_underway",
        "can_provide_underway"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "description": "Abstract stores."
    },
    "naval_weapon_system": {
      "type": "object",
      "properties": {
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Example-defined nested object."
          },
          "description": "Weapon mounts."
        }
      },
      "required": [
        "mounts"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "description": "Weapon-system mounts."
    },
    "damage_model": {
      "type": "object",
      "properties": {
        "hitboxes": {
          "type": "array",
          "items": {
            "$ref": "urn:echelon-forge:equipment-common:v1#/$defs/Hitbox",
            "description": "Ship hitbox."
          },
          "description": "Hitboxes."
        }
      },
      "required": [
        "hitboxes"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "description": "Damage configuration."
    },
    "_real_world": {
      "type": "object",
      "additionalProperties": true,
      "description": "Example-defined nested object."
    },
    "_provenance": {
      "$ref": "urn:echelon-forge:equipment-common:v1#/$defs/Provenance",
      "description": "Provenance."
    }
  },
  "required": [
    "name",
    "type",
    "ship_platform",
    "health",
    "sensor_ref",
    "sensor_refs",
    "esm",
    "has_command_link",
    "command_link",
    "has_data_link",
    "data_link_network_id",
    "naval_stores",
    "naval_weapon_system",
    "damage_model",
    "_real_world",
    "_provenance"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {}
  }
}

